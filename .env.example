# Copy this file to .env for local development. Do not commit the populated .env file.
# Double underscores map to nested .NET configuration sections, for example
# ConnectionString__DefaultConnection becomes ConnectionString:DefaultConnection.
# Npgsql uses PostgreSQL key/value connection strings.

ConnectionString__DefaultConnection="Host=localhost;Port=5432;Database=mockinterviews;Username=postgres;Password=replace-me;SSL Mode=Disable"
IntegrationTests__ConnectionString="Host=localhost;Port=5432;Database=mock_interviews_test_db;Username=postgres;Password=replace-me;SSL Mode=Disable"

# Development defaults to local SMTP/Mailpit and does not need an email credential.
# Production uses SendGrid; explicitly set both values in the production environment.
# Email__Provider=SendGrid
# SendGrid__ApiKey=replace-with-sendgrid-api-key
SuperUser__Email=replace-with-superuser-email
SeededAdminPwd=replace-with-seeded-admin-password

# Optional Microsoft sign-in. Leave both unset for local-account-only authentication.
Authentication__Microsoft__ClientId=replace-with-microsoft-client-id
Authentication__Microsoft__ClientSecret=replace-with-microsoft-client-secret
