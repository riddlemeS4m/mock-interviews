# Copy this file to .env for local development. Do not commit the populated .env file.
# Double underscores map to nested .NET configuration sections, for example
# ConnectionStrings__Users becomes ConnectionStrings:Users.

ConnectionStrings__Users="Host=localhost;Port=5432;Database=mockinterviews_users;Username=postgres;Password=replace-me"
ConnectionStrings__Signups="Host=localhost;Port=5432;Database=mockinterviews_signups;Username=postgres;Password=replace-me"

Authentication__Microsoft__ClientId=replace-with-microsoft-client-id
Authentication__Microsoft__ClientSecret=replace-with-microsoft-client-secret
SendGrid__ApiKey=replace-with-sendgrid-api-key
SeededAdminPwd=replace-with-seeded-admin-password

GoogleDriveFolders__SiteContent=replace-with-site-content-folder-id
GoogleDriveFolders__Resumes=replace-with-resumes-folder-id
GoogleDriveFolders__PFPs=replace-with-pfps-folder-id

GoogleCredential__type=service_account
GoogleCredential__project_id=replace-with-google-project-id
GoogleCredential__private_key_id=replace-with-google-private-key-id
# Keep the local private key quoted. DotNetEnv converts the escaped \n sequences to newlines.
GoogleCredential__private_key="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GoogleCredential__client_email=replace-with-service-account-email
GoogleCredential__client_id=replace-with-service-account-client-id
GoogleCredential__auth_uri=https://accounts.google.com/o/oauth2/auth
GoogleCredential__token_uri=https://oauth2.googleapis.com/token
GoogleCredential__auth_provider_x509_cert_url=https://www.googleapis.com/oauth2/v1/certs
GoogleCredential__client_x509_cert_url=replace-with-service-account-certificate-url
