@model FeedbackFormViewModel

@{
    ViewData["Title"] = "Give feedback";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-3xl space-y-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <partial name="DesignSystem/_PageHeader"
                 model='new UiPageHeaderViewModel("Give feedback", "Tell us about this completed interview. A rating of 1 is poor and 5 is excellent.")' />
        <a asp-action="FeedbackIndex" class="shrink-0 text-sm font-semibold text-ink hover:underline">Back to feedback</a>
    </div>

    <div class="rounded-card border border-line bg-surface p-5 shadow-card">
        <dl class="grid gap-4 text-sm sm:grid-cols-2">
            <div>
                <dt class="font-semibold text-ink">Date and time</dt>
                <dd class="mt-1 text-muted"><time datetime="@Model.Date.ToString("yyyy-MM-dd")">@Model.Date.ToString("MMM d, yyyy")</time> at @Model.Time.ToString("h:mm tt")</dd>
            </div>
            <div>
                <dt class="font-semibold text-ink">Interviewer</dt>
                <dd class="mt-1 text-muted">@Model.InterviewerName</dd>
            </div>
            <div>
                <dt class="font-semibold text-ink">Interview focus</dt>
                <dd class="mt-1 text-muted">@Model.InterviewType</dd>
            </div>
        </dl>
    </div>

    <form asp-action="ProvideFeedback" asp-route-id="@Model.Id" class="space-y-6 rounded-card border border-line bg-surface p-5 shadow-card sm:p-6">
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-l-negative pl-4 text-sm text-negative"></div>
        <input asp-for="Id" type="hidden" />

        <fieldset>
            <legend class="text-base font-semibold text-ink">@Html.DisplayNameFor(model => model.InterviewerRating)</legend>
            <p id="rating-scale-help" class="mt-1 text-sm text-muted">Choose one rating: 1 is poor and 5 is excellent.</p>
            <div class="mt-4 grid grid-cols-5 gap-2" aria-describedby="rating-scale-help">
                @for (var rating = 1; rating <= 5; rating++)
                {
                    var ratingValue = rating.ToString();
                    var ratingId = $"rating-{rating}";
                    <label for="@ratingId" class="flex min-h-12 cursor-pointer items-center justify-center rounded-md border border-line bg-surface font-semibold text-ink hover:bg-canvas has-[:checked]:border-ink has-[:checked]:bg-soft">
                        <input asp-for="InterviewerRating" id="@ratingId" value="@ratingValue" type="radio" class="sr-only" />
                        <span aria-hidden="true">@rating</span><span class="sr-only">@rating out of 5</span>
                    </label>
                }
            </div>
            <span asp-validation-for="InterviewerRating" class="mt-2 block text-sm text-negative"></span>
        </fieldset>

        <div>
            <label asp-for="InterviewerFeedback" class="block text-base font-semibold text-ink"></label>
            <p class="mt-1 text-sm text-muted">Optional: share specific observations that may help the interviewer.</p>
            <textarea asp-for="InterviewerFeedback" rows="5" class="mt-3 block w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm placeholder:text-muted focus:border-ink focus:outline-none focus:ring-3 focus:ring-ink/10"></textarea>
            <span asp-validation-for="InterviewerFeedback" class="mt-2 block text-sm text-negative"></span>
        </div>

        <div>
            <label asp-for="ProcessFeedback" class="block text-base font-semibold text-ink"></label>
            <p class="mt-1 text-sm text-muted">Optional: tell us what worked well or could improve in the scheduling and interview process.</p>
            <textarea asp-for="ProcessFeedback" rows="5" class="mt-3 block w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm placeholder:text-muted focus:border-ink focus:outline-none focus:ring-3 focus:ring-ink/10"></textarea>
            <span asp-validation-for="ProcessFeedback" class="mt-2 block text-sm text-negative"></span>
        </div>

        <div class="flex flex-wrap items-center gap-4">
            <button type="submit" ui-variant="Primary">Save feedback</button>
            <a asp-action="FeedbackIndex" class="text-sm font-semibold text-ink hover:underline">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
