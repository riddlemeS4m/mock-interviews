@model FeedbackListViewModel

@{
    ViewData["Title"] = "Interview feedback";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Interview feedback", "Share feedback after each completed interview. Your comments help us improve future mock interviews.")' />

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <partial name="DesignSystem/_Feedback"
                 model="new UiFeedbackViewModel(UiFeedbackKind.Success, statusMessage, string.Empty)" />
    }

    @if (Model.Interviews.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new UiEmptyStateViewModel("clipboard-check", "No completed interviews yet", "Feedback becomes available here as soon as each interview is marked complete.")' />
    }
    else
    {
        <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-line text-left text-sm">
                    <thead class="bg-soft/60 text-xs font-semibold uppercase tracking-wide text-muted">
                        <tr>
                            <th scope="col" class="px-5 py-3">Interview</th>
                            <th scope="col" class="px-5 py-3">Interviewer</th>
                            <th scope="col" class="px-5 py-3">Rating</th>
                            <th scope="col" class="px-5 py-3">Your feedback</th>
                            <th scope="col" class="px-5 py-3 text-right"><span class="sr-only">Action</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var interview in Model.Interviews)
                        {
                            var hasFeedback = !string.IsNullOrWhiteSpace(interview.InterviewerRating);
                            <tr>
                                <td class="whitespace-nowrap px-5 py-4">
                                    <time datetime="@interview.Date.ToString("yyyy-MM-dd")" class="font-semibold text-ink">@interview.Date.ToString("MMM d, yyyy")</time>
                                    <span class="block text-muted">@interview.Time.ToString("h:mm tt") · @interview.InterviewType</span>
                                </td>
                                <td class="px-5 py-4 text-ink">@interview.InterviewerName</td>
                                <td class="px-5 py-4 text-ink">@(hasFeedback ? $"{interview.InterviewerRating} / 5" : "Not rated")</td>
                                <td class="max-w-md px-5 py-4 text-muted">
                                    @if (hasFeedback)
                                    {
                                        <span>@(string.IsNullOrWhiteSpace(interview.InterviewerFeedback) ? "No written interviewer feedback" : interview.InterviewerFeedback)</span>
                                    }
                                    else
                                    {
                                        <span>No feedback submitted</span>
                                    }
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-right">
                                    <a asp-action="ProvideFeedback" asp-route-id="@interview.InterviewId" class="text-sm font-semibold text-ink hover:underline">@(hasFeedback ? "Edit feedback" : "Give feedback")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
