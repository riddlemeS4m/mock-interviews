@using MockInterviews.Data.Constants
@model MockInterviews.Models.ViewModels.InterviewEventsController.InterviewEventSignupViewModel

@{
    ViewData["Title"] = "Schedule interviews";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-5xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Schedule interviews", "Choose a start time. Your two interviews will be scheduled as separate 30-minute appointments.")' />

    @if (Model.StudentClass == Classes.NotEnrolled)
    {
        <partial name="DesignSystem/_Feedback" model='new UiFeedbackViewModel(UiFeedbackKind.Warning, "Update your profile first", "Choose your class in your profile before scheduling an interview.")' />
    }
    else if (Model.SignedUp)
    {
        <partial name="DesignSystem/_Feedback" model='new UiFeedbackViewModel(UiFeedbackKind.Warning, "You are already scheduled", "Your current interview appointments are available on your schedule.")' />
    }
    else if (Model.EventDays.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState" model='new UiEmptyStateViewModel("calendar-days", "No interview times available", "Please check back later for newly available interview times.")' />
    }
    else
    {
        <form asp-action="Create" class="space-y-6">
            <div asp-validation-summary="All" class="border-l-4 border-l-negative pl-4 text-sm text-negative"></div>
            <partial name="ParticipantScheduling/_EventDayTimeslotSelector"
                     model='new TimeslotSelectorViewModel(Model.EventDays, "SelectedTimeslotIds", false, false, "interview-timeslot")' />
            <button type="submit" ui-variant="Primary">Schedule interviews</button>
        </form>
    }
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
