@model MockInterviews.Models.Entities.Interview

@{
    ViewData["Title"] = "Cancel interview";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Cancel interview", "This permanently removes this individual interview from your schedule.")' />

    <partial name="DesignSystem/_Feedback"
             model='new UiFeedbackViewModel(UiFeedbackKind.Warning, "Confirm cancellation", "This action cannot be undone.")' />

    <form asp-action="UserDeleteConfirmed" class="flex flex-wrap items-center gap-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" ui-variant="Primary" class="bg-negative hover:bg-negative/90 focus-visible:outline-negative">Cancel interview</button>
        <a asp-controller="Home" asp-action="Index" class="text-sm font-semibold text-ink hover:underline">Keep interview</a>
    </form>
</section>
