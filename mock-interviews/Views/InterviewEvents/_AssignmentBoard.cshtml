@using MockInterviews.Models.ViewModels.Shared
@model MockInterviews.Models.ViewModels.InterviewEventsController.AssignmentBoardViewModel

<div id="assignment-board-region" class="space-y-8" aria-live="polite">
    <section aria-labelledby="available-interviewers-heading" class="rounded-card border border-line bg-surface p-5 shadow-card sm:p-6">
        <div class="flex items-center gap-3">
            <ui-icon name="users" class="size-5 text-muted" />
            <div>
                <h2 id="available-interviewers-heading" class="text-xl font-semibold text-ink">Available interviewers</h2>
                <p class="mt-1 text-sm text-muted">Checked in and not currently conducting an interview.</p>
            </div>
        </div>
        @if (Model.AvailableInterviewers.Count == 0)
        {
            <p class="mt-5 text-sm text-muted">No interviewers are currently available.</p>
        }
        else
        {
            <ul class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (var interviewer in Model.AvailableInterviewers)
                {
                    <li class="rounded-md border border-line bg-canvas px-4 py-3">
                        <p class="font-semibold text-ink">@interviewer.Name</p>
                        <p class="mt-1 text-sm text-muted">@interviewer.InterviewTypes · @interviewer.Room</p>
                    </li>
                }
            </ul>
        }
    </section>

    <partial name="_AssignmentBoardSection" model='(Model.CheckedIn, "Checked-in students", "Students waiting to be assigned are shown here.", "circle-check")' />
    <partial name="_AssignmentBoardSection" model='(Model.Ongoing, "Ongoing interviews", "Interviews currently in progress.", "clock")' />
    <partial name="_AssignmentBoardSection" model='(Model.Upcoming, "Upcoming students", "Students who have not arrived yet.", "calendar-days")' />
</div>
