@using MockInterviews.Data.Constants
@using MockInterviews.Models.ViewModels.InterviewEventsController
@model (IReadOnlyList<AssignmentBoardInterviewViewModel> Rows, string Heading, string EmptyMessage)

<section aria-labelledby="@Model.Heading.Replace(" ", "-").ToLowerInvariant()">
    <h2 id="@Model.Heading.Replace(" ", "-").ToLowerInvariant()">@Model.Heading</h2>
    @if (Model.Rows.Count == 0)
    {
        <p class="empty-state">@Model.EmptyMessage</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Class</th>
                        <th>Scheduled</th>
                        <th>Type</th>
                        <th>Interviewer</th>
                        <th>Room</th>
                        <th>Status</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var interview in Model.Rows)
                    {
                        <tr data-interview-id="@interview.InterviewId">
                            <td>@interview.StudentName</td>
                            <td>@interview.StudentClass</td>
                            <td><time datetime="@interview.EventDate.Add(interview.ScheduledTime.TimeOfDay).ToString("O")">@interview.EventDate.ToString("M/d/yyyy") @interview.ScheduledTime.ToString("h:mm tt")</time></td>
                            <td>@interview.InterviewType</td>
                            <td>
                                @interview.InterviewerName
                                @if (interview.IsOverride)
                                {
                                    <span>(override)</span>
                                }
                            </td>
                            <td>@interview.Room</td>
                            <td>@interview.Status</td>
                            <td>
                                @if (interview.Status == StatusConstants.Default)
                                {
                                    <form asp-action="StudentCheckIn" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@interview.InterviewId" />
                                        <button type="submit" class="btn btn-link p-0">Check in</button>
                                    </form>
                                    <span aria-hidden="true">|</span>
                                }
                                @if (interview.Status == StatusConstants.CheckedIn)
                                {
                                    <a asp-action="Edit" asp-route-id="@interview.InterviewId">Assign</a>
                                    <span aria-hidden="true">|</span>
                                }
                                @if (interview.Status is StatusConstants.CheckedIn or StatusConstants.Ongoing)
                                {
                                    <a asp-action="Override" asp-route-id="@interview.InterviewId">Override</a>
                                    <span aria-hidden="true">|</span>
                                    <form asp-action="StudentComplete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@interview.InterviewId" />
                                        <button type="submit" class="btn btn-link p-0">Complete</button>
                                    </form>
                                }
                                @if (interview.Status is StatusConstants.Default or StatusConstants.CheckedIn)
                                {
                                    <span aria-hidden="true">|</span>
                                    <form asp-action="StudentNoShow" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@interview.InterviewId" />
                                        <button type="submit" class="btn btn-link p-0">No show</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
