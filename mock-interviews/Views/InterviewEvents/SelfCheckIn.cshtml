@using MockInterviews.Models.ViewModels
@model SelfCheckInViewModel

@{
    ViewData["Title"] = "Interview check-in";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
    var kind = Model.IsCheckedIn ? UiFeedbackKind.Success : UiFeedbackKind.Warning;
    var title = Model.IsCheckedIn ? "You are checked in" : "Interview check-in";
}

<section class="mx-auto max-w-xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Interview check-in", "Check in when you have arrived for your scheduled interview.")' />
    <partial name="DesignSystem/_Feedback" model="new UiFeedbackViewModel(kind, title, Model.CheckInMessage)" />

    @if (!Model.IsCheckedIn && Model.CheckInMessage.StartsWith("Confirm", StringComparison.Ordinal))
    {
        <form asp-action="StudentSelfCheckInConfirmed">
            <button type="submit" ui-variant="Primary">Confirm check-in</button>
        </form>
    }
    else
    {
        <a asp-controller="Home" asp-action="Index" ui-variant="Quiet">Return to schedule</a>
    }
</section>
