@using MockInterviews.Models.ViewModels.Shared
@model MockInterviews.Models.ViewModels.InterviewEventsController.AssignmentBoardInterviewViewModel

@{
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
    ViewData["Title"] = "Override assignment";
}

<section class="mx-auto max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Override assignment", $"{Model.StudentName} · {Model.EventDate:MMM d} at {Model.ScheduledTime:h:mm tt}")' />
    <partial name="DesignSystem/_Feedback"
             model='new UiFeedbackViewModel(UiFeedbackKind.Warning, "Use only for an intentional exception", "An override may bypass exact-timeslot availability, interviewer check-in, interview type, or a current assignment. The selected interviewer must still have real availability for this event.")' />
    <div class="rounded-card border border-line bg-surface p-6 shadow-card">
        <form asp-action="Override" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.InterviewId" />
            <div>
                <label for="interviewerId" ui-label>Interviewer</label>
                <select id="interviewerId" name="interviewerId" ui-control>
                    <option value="">Select an interviewer</option>
                    @foreach (var candidate in Model.OverrideCandidates)
                    {
                        <option value="@candidate.InterviewerId">@candidate.Name@(candidate.Bypasses.Count > 0 ? $" — bypasses {string.Join(", ", candidate.Bypasses)}" : string.Empty)</option>
                    }
                </select>
            </div>
            <div class="flex flex-wrap justify-end gap-3"><a asp-action="Index" ui-variant="Secondary">Cancel</a><button type="submit" ui-variant="Primary">Confirm override</button></div>
        </form>
    </div>
</section>
