@using MockInterviews.Models.ViewModels.Shared
@model MockInterviews.Models.ViewModels.InterviewEventsController.AssignmentBoardInterviewViewModel

@{
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
    ViewData["Title"] = "Assign interviewer";
}

<section class="mx-auto max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Assign interviewer", $"{Model.StudentName} · {Model.EventDate:MMM d} at {Model.ScheduledTime:h:mm tt}")' />
    <div class="rounded-card border border-line bg-surface p-6 shadow-card">
        <form asp-action="Edit" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.InterviewId" />
            <div>
                <label for="interviewerId" ui-label>Eligible interviewer</label>
                <select id="interviewerId" name="interviewerId" ui-control>
                    <option value="">Select an interviewer</option>
                    @foreach (var candidate in Model.NormalCandidates)
                    {
                        <option value="@candidate.InterviewerId">@candidate.Name · @candidate.Room</option>
                    }
                </select>
                @if (Model.NormalCandidates.Count == 0)
                {
                    <p class="mt-2 text-sm text-muted">No normal assignment is available. Use a deliberate override only when an exception is required.</p>
                }
            </div>
            <div class="flex flex-wrap justify-end gap-3">
                <a asp-action="Index" ui-variant="Secondary">Cancel</a>
                <button type="submit" ui-variant="Primary" disabled="@(Model.NormalCandidates.Count == 0 ? "disabled" : null)">Assign and start</button>
            </div>
        </form>
    </div>
</section>
