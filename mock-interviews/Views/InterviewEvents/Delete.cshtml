@using MockInterviews.Models.ViewModels.Shared
@model MockInterviews.Models.ViewModels.InterviewEventsController.InterviewEventViewModel

@{
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
    ViewData["Title"] = "Delete interview";
}

<section class="mx-auto max-w-xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Delete interview", "Use this correction only when an interview must be permanently removed.")' />

    <partial name="DesignSystem/_Feedback"
             model='new UiFeedbackViewModel(UiFeedbackKind.Warning, "This cannot be undone", "The interview and its assignment history will be removed.")' />

    <dl class="divide-y divide-line overflow-hidden rounded-card border border-line bg-surface shadow-card">
        <div class="grid gap-1 px-5 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-semibold text-muted">Student</dt><dd class="sm:col-span-2">@Model.StudentName</dd></div>
        <div class="grid gap-1 px-5 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-semibold text-muted">Scheduled</dt><dd class="sm:col-span-2">@Model.InterviewEvent.Timeslot.Event.Date.ToString("MMM d, yyyy") · @Model.InterviewEvent.Timeslot.Time.ToString("h:mm tt")</dd></div>
        <div class="grid gap-1 px-5 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-semibold text-muted">Interview</dt><dd class="sm:col-span-2">@Model.InterviewEvent.Type</dd></div>
        <div class="grid gap-1 px-5 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-semibold text-muted">Interviewer</dt><dd class="sm:col-span-2">@Model.InterviewerName</dd></div>
    </dl>

    <form asp-action="Delete" method="post" class="flex flex-wrap items-center gap-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.InterviewEvent.Id" />
        <button type="submit" ui-variant="Primary" class="bg-negative hover:bg-negative/90 focus-visible:outline-negative">Delete interview</button>
        <a asp-action="Index" class="text-sm font-semibold text-ink hover:underline">Keep interview</a>
    </form>
</section>
