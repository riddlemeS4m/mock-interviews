@model MockInterviews.Models.ViewModels.InterviewEventsController.InterviewSignupByAdminViewModel

@{
    ViewData["Title"] = "Add student interview";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-5xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Add student interview", "Choose a student and one 30-minute start time. The established two-interview schedule is created from the adjacent time block.")' />

    @if (Model.EventDays.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new UiEmptyStateViewModel("calendar-days", "No interview times available", "There are no active consecutive interview times with remaining capacity.")' />
    }
    else
    {
        <form asp-action="CreateForStudent" method="post" class="space-y-8">
            <div asp-validation-summary="All" class="border-l-4 border-l-negative pl-4 text-sm text-negative"></div>

            <div class="rounded-card border border-line bg-surface p-5 shadow-card sm:p-6">
                <label asp-for="StudentId" class="block text-sm font-semibold text-ink">Student</label>
                <select asp-for="StudentId" asp-items="Model.Students" class="mt-2 block min-h-11 w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm sm:max-w-xl">
                    <option value="">Select a student</option>
                </select>
                <span asp-validation-for="StudentId" class="mt-1 block text-sm text-negative"></span>
            </div>

            <partial name="ParticipantScheduling/_EventDayTimeslotSelector"
                     model='new TimeslotSelectorViewModel(Model.EventDays, "SelectedTimeslotIds", false, false, "admin-student-timeslot")' />

            <div class="flex flex-wrap items-center gap-3">
                <button type="submit" ui-variant="Primary">Add interview schedule</button>
                <a asp-action="Index" ui-variant="Quiet">Back to assignment board</a>
            </div>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
