@using MockInterviews.Models.ViewModels.InterviewEventsController
@using MockInterviews.Models.ViewModels.Shared
@model PreAssignmentPageViewModel

@{
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
    ViewData["Title"] = "Pre-assign interviews";
}

<section class="space-y-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <partial name="DesignSystem/_PageHeader"
                 model='new UiPageHeaderViewModel("Pre-assign interviews", "Plan waiting interviews by exact event timeslot. Each timeslot saves as one atomic update.")' />
        <a asp-action="Index" ui-variant="Secondary" class="shrink-0">
            <ui-icon name="users" class="size-4" />
            Assignment board
        </a>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <partial name="DesignSystem/_Feedback"
                 model="new UiFeedbackViewModel(UiFeedbackKind.Success, statusMessage, string.Empty)" />
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" ui-validation-summary></div>
    }

    @if (Model.Timeslots.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new UiEmptyStateViewModel("calendar-days", "No waiting interviews", "There are no active, not-arrived interviews available to pre-assign.")' />
    }
    else
    {
        @foreach (var dateGroup in Model.Timeslots.GroupBy(timeslot => timeslot.EventDate.Date))
        {
            <section class="space-y-4" aria-labelledby="preassignment-date-@dateGroup.Key.ToString("yyyyMMdd")">
                <div class="flex items-center gap-3">
                    <ui-icon name="calendar-days" class="size-5 text-muted" />
                    <h2 id="preassignment-date-@dateGroup.Key.ToString("yyyyMMdd")" class="text-xl font-semibold text-ink">@dateGroup.Key.ToString("dddd, MMMM d")</h2>
                </div>

                @foreach (var timeslot in dateGroup)
                {
                    var groupId = $"preassignment-timeslot-{timeslot.TimeslotId}";
                    <form asp-action="PreAssignInterviews" method="post" class="overflow-hidden rounded-card border border-line bg-surface shadow-card" aria-labelledby="@groupId">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TimeslotId" value="@timeslot.TimeslotId" />
                        <div class="flex flex-col gap-3 border-b border-line bg-soft px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <h3 id="@groupId" class="flex items-center gap-2 text-lg font-semibold text-ink">
                                    <ui-icon name="clock" class="size-5 text-muted" />
                                    @timeslot.ScheduledTime.ToString("h:mm tt")
                                </h3>
                                <p class="mt-1 text-sm text-muted">@timeslot.EventName · @timeslot.Interviews.Count waiting student@(timeslot.Interviews.Count == 1 ? string.Empty : "s")</p>
                            </div>
                            <button type="submit" ui-variant="Primary">Save this timeslot</button>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="min-w-full text-left text-sm">
                                <thead class="border-b border-line text-muted">
                                    <tr>
                                        <th scope="col" class="px-5 py-3 font-semibold">Student</th>
                                        <th scope="col" class="px-5 py-3 font-semibold">Interview</th>
                                        <th scope="col" class="min-w-72 px-5 py-3 font-semibold">Eligible interviewer</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-line">
                                    @for (var index = 0; index < timeslot.Interviews.Count; index++)
                                    {
                                        var interview = timeslot.Interviews[index];
                                        var selectId = $"preassignment-{timeslot.TimeslotId}-{interview.InterviewId}";
                                        <tr>
                                            <th scope="row" class="px-5 py-4 font-semibold text-ink">
                                                @interview.StudentName
                                                @if (!string.IsNullOrWhiteSpace(interview.StudentClass))
                                                {
                                                    <span class="mt-0.5 block text-xs font-normal text-muted">@interview.StudentClass</span>
                                                }
                                            </th>
                                            <td class="px-5 py-4 text-ink">@interview.InterviewType</td>
                                            <td class="px-5 py-4">
                                                <input type="hidden" name="Assignments[@index].InterviewId" value="@interview.InterviewId" />
                                                <label for="@selectId" class="sr-only">Interviewer for @interview.StudentName</label>
                                                <select id="@selectId" name="Assignments[@index].InterviewerId" ui-control>
                                                    <option value="">Unassigned</option>
                                                    @foreach (var candidate in interview.Candidates)
                                                    {
                                                        <option value="@candidate.InterviewerId" selected="@(candidate.InterviewerId == interview.AssignedInterviewerId ? "selected" : null)">@candidate.Name · @candidate.Room</option>
                                                    }
                                                </select>
                                                @if (interview.Candidates.Count == 0)
                                                {
                                                    <p class="mt-2 text-xs text-muted">No checked-in, type-compatible interviewer is available for this exact timeslot.</p>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </form>
                }
            </section>
        }
    }
</section>
