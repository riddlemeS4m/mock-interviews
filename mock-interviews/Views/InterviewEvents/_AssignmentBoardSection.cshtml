@using MockInterviews.Data.Constants
@using MockInterviews.Models.ViewModels.InterviewEventsController
@using MockInterviews.Models.ViewModels.Shared
@model (IReadOnlyList<AssignmentBoardInterviewViewModel> Rows, string Heading, string Description, string Icon)

@{
    var headingId = $"assignment-{Model.Heading.Replace(" ", "-").ToLowerInvariant()}";
    const string returnUrl = "/InterviewEvents";
}

<section aria-labelledby="@headingId" class="space-y-4">
    <div class="flex items-start gap-3">
        <ui-icon name="@Model.Icon" class="mt-0.5 size-5 text-muted" />
        <div>
            <h2 id="@headingId" class="text-xl font-semibold text-ink">@Model.Heading</h2>
            <p class="mt-1 text-sm text-muted">@Model.Description</p>
        </div>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new UiEmptyStateViewModel(Model.Icon, $"No {Model.Heading.ToLowerInvariant()}", Model.Description)' />
    }
    else
    {
        <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
            <div class="overflow-x-auto">
                <table class="min-w-full text-left text-sm">
                    <thead class="border-b border-line bg-soft text-muted">
                        <tr>
                            <th scope="col" class="px-5 py-3 font-semibold">Student</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Scheduled</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Interview</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Interviewer</th>
                            <th scope="col" class="px-5 py-3 text-right font-semibold"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var interview in Model.Rows)
                        {
                            <tr data-interview-id="@interview.InterviewId">
                                <th scope="row" class="px-5 py-4 font-semibold text-ink">
                                    @interview.StudentName
                                    @if (!string.IsNullOrWhiteSpace(interview.StudentClass))
                                    {
                                        <span class="mt-0.5 block text-xs font-normal text-muted">@interview.StudentClass</span>
                                    }
                                </th>
                                <td class="whitespace-nowrap px-5 py-4 text-ink">
                                    <time datetime="@interview.EventDate.Add(interview.ScheduledTime.TimeOfDay).ToString("O")">@interview.EventDate.ToString("MMM d") · @interview.ScheduledTime.ToString("h:mm tt")</time>
                                </td>
                                <td class="px-5 py-4 text-ink">
                                    @interview.InterviewType
                                    <span class="mt-1 flex items-center gap-2 text-xs text-muted">
                                        <span class="size-2 rounded-full @(interview.Status == StatusConstants.Ongoing ? "bg-positive" : interview.Status == StatusConstants.CheckedIn ? "bg-warning" : "bg-muted")" aria-hidden="true"></span>
                                        @interview.Status
                                    </span>
                                </td>
                                <td class="px-5 py-4 text-ink">
                                    @interview.InterviewerName
                                    @if (interview.IsOverride)
                                    {
                                        <span class="mt-1 block text-xs text-warning">Override</span>
                                    }
                                    <span class="mt-1 block text-xs text-muted">@interview.Room</span>
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-right">
                                    <div class="inline-flex flex-wrap justify-end gap-2">
                                        @if (interview.Status == StatusConstants.Default)
                                        {
                                            <form asp-action="StudentCheckIn" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@interview.InterviewId" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" ui-variant="Primary">Check in</button>
                                            </form>
                                        }
                                        @if (interview.Status == StatusConstants.CheckedIn)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@interview.InterviewId"
                                               ui-variant="Primary"
                                               data-dialog-target="assignment-dialog-@interview.InterviewId">Assign</a>
                                        }
                                        @if (interview.Status is StatusConstants.CheckedIn or StatusConstants.Ongoing)
                                        {
                                            <a asp-action="Override"
                                               asp-route-id="@interview.InterviewId"
                                               ui-variant="Secondary"
                                               data-dialog-target="override-dialog-@interview.InterviewId">Override</a>
                                            <form asp-action="StudentComplete" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@interview.InterviewId" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" ui-variant="Quiet">Complete</button>
                                            </form>
                                        }
                                        @if (interview.Status is StatusConstants.Default or StatusConstants.CheckedIn)
                                        {
                                            <form asp-action="StudentNoShow" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@interview.InterviewId" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" ui-variant="Quiet" class="text-negative hover:bg-negative/10">No show</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @foreach (var interview in Model.Rows.Where(row => row.Status == StatusConstants.CheckedIn))
        {
            <dialog id="assignment-dialog-@interview.InterviewId" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-card bg-transparent p-0 text-left text-ink shadow-2xl backdrop:bg-ink/50" aria-labelledby="assignment-dialog-@interview.InterviewId-title" data-dialog>
                <div class="rounded-card border border-line bg-surface p-6 sm:p-7">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h2 id="assignment-dialog-@interview.InterviewId-title" class="text-2xl font-semibold text-ink">Assign @interview.StudentName</h2>
                            <p class="mt-2 text-sm text-muted">Only eligible, checked-in interviewers for this exact timeslot are listed.</p>
                        </div>
                        <button type="button" class="inline-flex size-9 items-center justify-center rounded-md text-muted hover:bg-soft" aria-label="Close dialog" data-dialog-close><ui-icon name="x" class="size-5" /></button>
                    </div>
                    <form asp-action="Edit" method="post" class="mt-6 space-y-5">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@interview.InterviewId" />
                        <div>
                            <label for="assignment-interviewer-@interview.InterviewId" ui-label>Interviewer</label>
                            <select id="assignment-interviewer-@interview.InterviewId" name="interviewerId" ui-control data-dialog-initial-focus>
                                <option value="">Select an interviewer</option>
                                @foreach (var candidate in interview.NormalCandidates)
                                {
                                    <option value="@candidate.InterviewerId">@candidate.Name · @candidate.Room</option>
                                }
                            </select>
                            @if (interview.NormalCandidates.Count == 0)
                            {
                                <p class="mt-2 text-sm text-muted">No normal assignment is available right now. Use Override only for an intentional exception.</p>
                            }
                        </div>
                        <div class="flex justify-end gap-3"><button type="button" ui-variant="Secondary" data-dialog-close>Cancel</button><button type="submit" ui-variant="Primary" disabled="@(interview.NormalCandidates.Count == 0 ? "disabled" : null)">Assign and start</button></div>
                    </form>
                </div>
            </dialog>
        }

        @foreach (var interview in Model.Rows.Where(row => row.Status is StatusConstants.CheckedIn or StatusConstants.Ongoing))
        {
            <dialog id="override-dialog-@interview.InterviewId" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-card bg-transparent p-0 text-left text-ink shadow-2xl backdrop:bg-ink/50" aria-labelledby="override-dialog-@interview.InterviewId-title" data-dialog>
                <div class="rounded-card border border-line bg-surface p-6 sm:p-7">
                    <div class="flex items-start justify-between gap-4"><div><h2 id="override-dialog-@interview.InterviewId-title" class="text-2xl font-semibold text-ink">Override assignment</h2><p class="mt-2 text-sm text-muted">This can intentionally bypass normal availability rules. The server records the exceptions used.</p></div><button type="button" class="inline-flex size-9 items-center justify-center rounded-md text-muted hover:bg-soft" aria-label="Close dialog" data-dialog-close><ui-icon name="x" class="size-5" /></button></div>
                    <form asp-action="Override" method="post" class="mt-6 space-y-5">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@interview.InterviewId" />
                        <div><label for="override-interviewer-@interview.InterviewId" ui-label>Interviewer</label><select id="override-interviewer-@interview.InterviewId" name="interviewerId" ui-control data-dialog-initial-focus><option value="">Select an interviewer</option>@foreach (var candidate in interview.OverrideCandidates) { <option value="@candidate.InterviewerId">@candidate.Name@(candidate.Bypasses.Count > 0 ? $" — bypasses {string.Join(", ", candidate.Bypasses)}" : string.Empty)</option> }</select></div>
                        <div class="flex justify-end gap-3"><button type="button" ui-variant="Secondary" data-dialog-close>Cancel</button><button type="submit" ui-variant="Primary">Confirm override</button></div>
                    </form>
                </div>
            </dialog>
        }
    }
</section>
