@model MockInterviews.Models.ViewModels.ReportsController.AllocationReportViewModel

@{
    ViewData["Title"] = "Allocation report";
}

<section class="space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Allocation report", "The ten timeslots with the largest interviewer gaps and the ten with the greatest availability.")' />

    @if (Model.Top10Underserved.Count == 0 && Model.Top10Available.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new MockInterviews.Models.ViewModels.Shared.UiEmptyStateViewModel("calendar-days", "No allocation data", "Active interviewer timeslots will appear here when event schedules are available.")' />
    }
    else
    {
        <div class="grid gap-8 xl:grid-cols-2">
            <section class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
                <div class="border-b border-line px-5 py-4">
                    <h2 class="text-lg font-semibold text-ink">Most underserved</h2>
                    <p class="mt-1 text-sm text-muted">Highest student-to-interviewer gap.</p>
                </div>
                <partial name="_AllocationTable" model="Model.Top10Underserved" />
            </section>

            <section class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
                <div class="border-b border-line px-5 py-4">
                    <h2 class="text-lg font-semibold text-ink">Most available</h2>
                    <p class="mt-1 text-sm text-muted">Lowest student-to-interviewer gap.</p>
                </div>
                <partial name="_AllocationTable" model="Model.Top10Available" />
            </section>
        </div>
    }
</section>
