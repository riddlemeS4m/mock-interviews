@model MockInterviews.Models.ViewModels.TimeslotsController.TimeslotViewModel

@{
    ViewData["Title"] = "Signup report";
}

<section class="space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Signup report", "Active-event signup counts for each available timeslot.")' />

    @if (Model.Timeslots.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new MockInterviews.Models.ViewModels.Shared.UiEmptyStateViewModel("calendar-days", "No active timeslots", "Create and activate event timeslots to populate this report.")' />
    }
    else
    {
        <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
            <div class="overflow-x-auto">
                <table class="min-w-full text-left">
                    <thead class="border-b border-line bg-soft text-sm text-muted">
                        <tr>
                            <th scope="col" class="px-5 py-3 font-semibold">Date</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Time</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Students</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Interviewers</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Volunteers</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Capacity</th>
                            <th scope="col" class="px-5 py-3 text-right font-semibold"><span class="sr-only">Details</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var count in Model.Timeslots)
                        {
                            <tr>
                                <td class="whitespace-nowrap px-5 py-4 text-muted">@count.Timeslot.Event.Date.ToString("MMM d, yyyy")</td>
                                <td class="whitespace-nowrap px-5 py-4 font-semibold text-ink">@count.Timeslot.Time.ToString("h:mm tt")</td>
                                <td class="px-5 py-4 text-muted">@count.StudentCount</td>
                                <td class="px-5 py-4 text-muted">@count.InterviewerCount</td>
                                <td class="px-5 py-4 text-muted">@count.VolunteerCount</td>
                                <td class="px-5 py-4 text-muted">@count.Timeslot.MaxSignUps</td>
                                <td class="px-5 py-4 text-right">
                                    <a asp-controller="Timeslots" asp-action="Details" asp-route-id="@count.Timeslot.Id" class="text-sm font-semibold text-ink hover:underline">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
