@model List<MockInterviews.Models.ViewModels.ReportsController.ParticipantCountViewModel>

<div class="overflow-x-auto">
    <table class="min-w-full text-left text-sm">
        <thead class="bg-soft text-muted">
            <tr>
                <th scope="col" class="px-5 py-3 font-semibold">Date</th>
                <th scope="col" class="px-5 py-3 font-semibold">Time</th>
                <th scope="col" class="px-5 py-3 font-semibold">Students</th>
                <th scope="col" class="px-5 py-3 font-semibold">Interviewers</th>
                <th scope="col" class="px-5 py-3 font-semibold">Gap</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-line">
            @foreach (var count in Model)
            {
                <tr>
                    <td class="whitespace-nowrap px-5 py-4 text-muted">@count.Timeslot.Event.Date.ToString("MMM d, yyyy")</td>
                    <td class="whitespace-nowrap px-5 py-4 font-semibold text-ink">@count.Timeslot.Time.ToString("h:mm tt")</td>
                    <td class="px-5 py-4 text-muted">@count.StudentCount</td>
                    <td class="px-5 py-4 text-muted">@count.InterviewerCount</td>
                    <td class="px-5 py-4 font-semibold text-ink">@count.Difference</td>
                </tr>
            }
        </tbody>
    </table>
</div>
