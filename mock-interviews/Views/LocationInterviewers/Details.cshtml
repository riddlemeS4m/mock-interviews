@model MockInterviews.Models.ViewModels.LocationInterviewersController.LocationInterviewerWithName
@{ ViewData["Title"] = "Room assignment details"; }
<section class="max-w-xl space-y-6"><partial name="DesignSystem/_PageHeader" model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Room assignment details", "Current interviewer location assignment.")' /><dl class="rounded-card border border-line bg-surface p-6 shadow-card"><div class="grid gap-1 border-b border-line pb-4 sm:grid-cols-2"><dt class="font-semibold text-ink">Interviewer</dt><dd class="text-muted">@Model.InterviewerName</dd></div><div class="mt-4 grid gap-1 sm:grid-cols-2"><dt class="font-semibold text-ink">Room</dt><dd class="text-muted">@(Model.LocationInterviewer.Location?.Room ?? "Unassigned")</dd></div></dl><a asp-action="Index" ui-variant="Secondary">Back to assignments</a></section>
