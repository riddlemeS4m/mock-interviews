@model MockInterviews.Models.ViewModels.LocationInterviewersController.LocationInterviewerWithName

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Interviewer Location</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Interviewer
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.InterviewerName)
        </dd>
        <dt class = "col-sm-2">
            Room
        </dt>
        <dd class = "col-sm-10">
            @(Model.LocationInterviewer.Location?.Room ?? "Not assigned")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?LocationInterviewer.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
