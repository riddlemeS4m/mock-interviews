@model MockInterviews.Models.ViewModels.LocationInterviewersController.LocationInterviewerWithName

@{
    ViewData["Title"] = "Delete room assignment";
}

<section class="max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Delete room assignment", "This action cannot be undone.")' />
    <div class="rounded-card border border-negative/30 bg-surface p-6 shadow-card">
        <p class="leading-6 text-muted">Remove the room assignment for <strong class="text-ink">@Model.InterviewerName</strong>?</p>
        <dl class="mt-5 space-y-3 text-sm"><div class="grid gap-1 sm:grid-cols-2"><dt class="font-semibold text-ink">Room</dt><dd class="text-muted">@(Model.LocationInterviewer.Location?.Room ?? "Unassigned")</dd></div></dl>
        <form asp-action="Delete" method="post" class="mt-7 flex gap-3"><input name="id" value="@Model.LocationInterviewer.Id" type="hidden" /><a asp-action="Index" ui-variant="Secondary">Cancel</a><button type="submit" ui-variant="Destructive">Delete assignment</button></form>
    </div>
</section>
