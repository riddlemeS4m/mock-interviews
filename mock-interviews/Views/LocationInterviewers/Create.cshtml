@model MockInterviews.Models.ViewModels.LocationInterviewersController.LocationInterviewerCreateViewModel

@{
    ViewData["Title"] = "Assign room";
}

<section class="max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Assign room", "Choose an active interviewer, event, and room.")' />

    <form asp-action="Create" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-card">
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div>
        <div>
            <label asp-for="LocationInterviewer.InterviewerId" class="block text-sm font-semibold text-ink">Interviewer</label>
            <select asp-for="LocationInterviewer.InterviewerId" asp-items="Model.InterviewerNames" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2"><option value="">Choose an interviewer</option></select>
        </div>
        <div>
            <label asp-for="LocationInterviewer.EventId" class="block text-sm font-semibold text-ink">Event</label>
            <select asp-for="LocationInterviewer.EventId" asp-items="Model.Dates" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2"><option value="">Choose an event</option></select>
        </div>
        <div>
            <label asp-for="LocationInterviewer.LocationId" class="block text-sm font-semibold text-ink">Room or location</label>
            <select asp-for="LocationInterviewer.LocationId" asp-items="Model.Locations" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2"><option value="">Leave unassigned</option></select>
        </div>
        <fieldset class="space-y-3">
            <legend class="text-sm font-semibold text-ink">Preference</legend>
            <label class="flex gap-3"><input type="radio" name="InPerson" value="true" checked />In person</label>
            <label class="flex gap-3"><input type="radio" name="InPerson" value="false" />Virtual</label>
        </fieldset>
        <div class="flex gap-3"><a asp-action="Index" ui-variant="Secondary">Cancel</a><button type="submit" ui-variant="Primary">Assign room</button></div>
    </form>
</section>
