@model MockInterviews.Models.ViewModels.LocationInterviewersController.LocationInterviewerViewModel

@{
    ViewData["Title"] = "Assign rooms";
}

<section class="space-y-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <partial name="DesignSystem/_PageHeader"
                 model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Assign rooms", "Set the room or virtual location for interviewers with active availability.")' />
        <a asp-action="Create" ui-variant="Primary">
            <ui-icon name="plus" class="size-4" />
            Assign room
        </a>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <partial name="DesignSystem/_Feedback"
                 model="new MockInterviews.Models.ViewModels.Shared.UiFeedbackViewModel(MockInterviews.Models.ViewModels.Shared.UiFeedbackKind.Success, statusMessage, string.Empty)" />
    }

    @if (!Model.LocationInterviewerWithNames.Any())
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new MockInterviews.Models.ViewModels.Shared.UiEmptyStateViewModel("map-pin", "No room assignments", "Active interviewer availability is required before a room can be assigned.")' />
    }
    else
    {
        <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
            <div class="overflow-x-auto">
                <table class="min-w-full text-left">
                    <thead class="border-b border-line bg-soft text-sm text-muted">
                        <tr>
                            <th class="px-5 py-3 font-semibold">Interviewer</th>
                            <th class="px-5 py-3 font-semibold">Event</th>
                            <th class="px-5 py-3 font-semibold">Preference</th>
                            <th class="px-5 py-3 font-semibold">Room</th>
                            <th class="px-5 py-3 text-right font-semibold"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var item in Model.LocationInterviewerWithNames)
                        {
                            var eventLabel = item.LocationInterviewer.Event is { } assignedEvent
                                ? $"{assignedEvent.Name} ({assignedEvent.Date:MMM d, yyyy})"
                                : "Not assigned";
                            <tr>
                                <th scope="row" class="px-5 py-4 font-semibold text-ink">@item.InterviewerName</th>
                                <td class="px-5 py-4 text-muted">@eventLabel</td>
                                <td class="px-5 py-4 text-muted">@item.InterviewerPreference</td>
                                <td class="px-5 py-4 text-muted">@(item.LocationInterviewer.Location?.Room ?? "Unassigned")</td>
                                <td class="px-5 py-4 text-right">
                                    <a asp-action="Edit" asp-route-id="@item.LocationInterviewer.Id" class="text-sm font-semibold text-ink hover:underline">Edit</a>
                                    <span class="px-2 text-muted">·</span>
                                    <a asp-action="Delete" asp-route-id="@item.LocationInterviewer.Id" class="text-sm font-semibold text-negative hover:underline">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
