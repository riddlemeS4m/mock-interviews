@model MockInterviews.Models.ViewModels.LocationInterviewersController.LocationInterviewerCreateViewModel

@{
    ViewData["Title"] = "Update room assignment";
}

<section class="max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Update room assignment", $"Choose a room for {Model.InterviewerName}.")' />

    <form asp-action="Edit" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-card">
        <input asp-for="LocationInterviewer.Id" type="hidden" />
        <input asp-for="LocationInterviewer.InterviewerId" type="hidden" />
        <input asp-for="LocationInterviewer.EventId" type="hidden" />
        <input asp-for="LocationInterviewer.Preference" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div>
        <div>
            <label asp-for="LocationInterviewer.LocationId" class="block text-sm font-semibold text-ink">Room or location</label>
            <select asp-for="LocationInterviewer.LocationId" asp-items="Model.Locations" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2"><option value="">Leave unassigned</option></select>
        </div>
        <div class="flex gap-3"><a asp-action="Index" ui-variant="Secondary">Cancel</a><button type="submit" ui-variant="Primary">Save assignment</button></div>
    </form>
</section>
