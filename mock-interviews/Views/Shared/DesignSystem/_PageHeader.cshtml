@model UiPageHeaderViewModel

<header class="max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">@Model.Title</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="mt-3 text-lg leading-8 text-muted">@Model.Description</p>
    }
</header>
