@model UiFeedbackViewModel

@{
    var (accentClass, icon, role) = Model.Kind switch
    {
        UiFeedbackKind.Success => ("border-l-positive", "circle-check", "status"),
        UiFeedbackKind.Warning => ("border-l-warning", "triangle-alert", "status"),
        UiFeedbackKind.Error => ("border-l-negative", "circle-x", "alert"),
        _ => throw new InvalidOperationException($"Unknown feedback kind '{Model.Kind}'.")
    };
    var iconClass = Model.Kind switch
    {
        UiFeedbackKind.Success => "text-positive",
        UiFeedbackKind.Warning => "text-warning",
        UiFeedbackKind.Error => "text-negative",
        _ => string.Empty
    };
}

<div class="rounded-card border border-line border-l-4 @accentClass bg-surface p-5 shadow-sm" role="@role">
    <div class="flex gap-3">
        <ui-icon name="@icon" class="mt-0.5 size-5 shrink-0 @iconClass" />
        <div>
            <p class="font-semibold text-ink">@Model.Title</p>
            <p class="mt-1 text-sm leading-6 text-muted">@Model.Message</p>
        </div>
    </div>
</div>
