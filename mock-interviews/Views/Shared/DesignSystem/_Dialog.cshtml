@model UiDialogViewModel

@{
    var titleId = $"{Model.Id}-title";
    var descriptionId = $"{Model.Id}-description";
}

<dialog id="@Model.Id"
        class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-card bg-transparent p-0 text-left text-ink shadow-2xl backdrop:bg-ink/50 backdrop:backdrop-blur-[1px]"
        aria-labelledby="@titleId"
        aria-describedby="@(!string.IsNullOrWhiteSpace(Model.Description) ? descriptionId : null)"
        data-dialog
        data-dialog-auto-open="@(Model.AutoOpen ? "true" : "false")">
    <div class="max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-card border border-line bg-surface p-6 sm:p-7">
        <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
                <h2 id="@titleId" class="text-2xl font-semibold tracking-tight text-ink">@Model.Title</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p id="@descriptionId" class="mt-2 leading-6 text-muted">@Model.Description</p>
                }
            </div>
            <button type="button"
                    class="inline-flex size-9 shrink-0 items-center justify-center rounded-md text-muted transition-colors hover:bg-soft hover:text-ink"
                    aria-label="Close dialog"
                    data-dialog-close>
                <ui-icon name="x" class="size-5" />
            </button>
        </div>

        <div class="mt-6">
            @await Html.PartialAsync(Model.ContentPartial, Model.ContentModel)
        </div>
    </div>
</dialog>
