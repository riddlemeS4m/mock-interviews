@using Microsoft.AspNetCore.Identity
@using MockInterviews.Models.Identity
@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="flex items-center gap-2">
        <a asp-area="Identity"
           asp-page="/Account/Manage/Index"
           title="Profile"
           class="inline-flex min-h-10 items-center justify-center gap-2 rounded-md border border-line bg-surface px-3 py-2 text-sm font-semibold text-ink shadow-sm transition-colors hover:bg-canvas">
            <ui-icon name="user-round" class="size-[1.125rem]" />
            <span class="hidden sm:inline">Profile</span>
        </a>
        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit"
                    class="inline-flex min-h-10 items-center justify-center gap-2 rounded-md px-3 py-2 text-sm font-semibold text-ink transition-colors hover:bg-soft">
                <ui-icon name="log-out" class="size-[1.125rem]" />
                <span class="hidden sm:inline">Log out</span>
            </button>
        </form>
    </div>
}
else
{
    <a asp-area="Identity"
       asp-page="/Account/Login"
       class="inline-flex min-h-10 items-center justify-center rounded-md bg-ink px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-ink/90">
        Log in
    </a>
}
