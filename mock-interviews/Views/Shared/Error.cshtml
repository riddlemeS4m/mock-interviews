@using MockInterviews.Models.ViewModels
@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = User.Identity?.IsAuthenticated == true
        ? "/Views/Shared/_TailwindLayout.cshtml"
        : "/Views/Shared/_TailwindPublicLayout.cshtml";
}

<section class="mx-auto max-w-2xl py-8 text-center">
    <ui-icon name="triangle-alert" class="mx-auto size-10 text-negative" />
    <h1 class="mt-5 text-3xl font-bold tracking-tight text-ink">Something went wrong</h1>
    <p class="mx-auto mt-3 max-w-xl text-lg leading-8 text-muted">We could not complete that request. Try again, or return home and continue from there.</p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-5 text-sm text-muted">
            Request ID: <code class="rounded bg-soft px-1.5 py-1 font-mono text-ink">@Model.RequestId</code>
        </p>
    }

    <div class="mt-8 flex justify-center">
        <a asp-controller="Home" asp-action="Index" ui-variant="Primary">Return home</a>
    </div>
</section>
