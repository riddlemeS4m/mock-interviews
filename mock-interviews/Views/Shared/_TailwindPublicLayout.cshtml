<!DOCTYPE html>
<html lang="en-us" class="h-full">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <meta name="description" content="A platform for managing mock interviews.">

    <meta property="og:title" content="@ViewData["Title"] - Mock Interviews">
    <meta property="og:description" content="A platform for managing mock interviews.">

    <title>@ViewData["Title"] - Mock Interviews</title>

    <link rel="icon" href="~/favicon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true">

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="min-h-full">
    <a href="#main-content"
       class="fixed left-4 top-4 z-50 -translate-y-24 rounded-md bg-surface px-4 py-2 text-sm font-semibold text-ink shadow-lg transition-transform focus:translate-y-0">
        Skip to main content
    </a>

    <div class="flex min-h-screen flex-col">
        <header class="border-b border-line bg-surface">
            <div class="mx-auto flex min-h-16 w-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-3 font-semibold text-ink">
                    <span class="flex size-8 items-center justify-center rounded-md bg-brand-600 text-sm font-bold text-white" aria-hidden="true">M</span>
                    Mock Interviews
                </a>
                <nav aria-label="Public navigation" class="flex items-center gap-5 text-sm font-semibold text-ink">
                    <a asp-area="" asp-controller="FAQs" asp-action="Resources" class="hover:underline">Resources</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-area="" asp-controller="Home" asp-action="Landing" class="hover:underline">Dashboard</a>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" class="hover:underline">Sign in</a>
                    }
                </nav>
            </div>
        </header>

        <main id="main-content" class="mx-auto w-full max-w-7xl flex-1 px-4 py-10 sm:px-6 lg:px-8" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
