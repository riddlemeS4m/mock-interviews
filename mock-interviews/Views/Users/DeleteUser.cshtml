@model MockInterviews.Models.Identity.ApplicationUser

@{
    ViewData["Title"] = "Delete account";
}

<section class="max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Delete account", "This action cannot be undone.")' />

    <div class="rounded-card border border-negative/30 bg-surface p-6 shadow-card">
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div>
        <p class="leading-6 text-muted">
            Delete <strong class="text-ink">@Model.FirstName @Model.LastName</strong> (@Model.Email)?
            Accounts with related interview, signup, or assignment records cannot be deleted.
        </p>

        <form asp-action="DeleteUserConfirmed" method="post" class="mt-7 flex gap-3">
            <input name="id" value="@Model.Id" type="hidden" />
            <a asp-controller="UserRoles" asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Destructive">Delete account</button>
        </form>
    </div>
</section>
