@model ExternalUserProfileViewModel
@{
    var fullName = $"{Model.FirstName} {Model.LastName}";
    ViewData["Title"] = $"{fullName}'s profile";
}

<section class="mx-auto max-w-3xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel(fullName, "Student profile details for this interview.")' />

    <div class="grid gap-6 rounded-card border border-line bg-surface p-6 shadow-card sm:grid-cols-[auto_1fr] sm:items-center">
        <img src="~/images/SabanHeadshot.jpg"
             alt="Default profile picture for @fullName"
             class="size-32 rounded-full object-cover sm:size-40" />
        <dl>
            <dt class="text-sm font-semibold text-muted">Class</dt>
            <dd class="mt-1 text-lg font-semibold text-ink">@Model.Class</dd>
        </dl>
    </div>

    <a asp-controller="Home" asp-action="Landing" ui-variant="Quiet">Back to home</a>
</section>
