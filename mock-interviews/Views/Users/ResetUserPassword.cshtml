@model MockInterviews.Models.ViewModels.UsersController.ResetPasswordViewModel

@{
    ViewData["Title"] = "Send password reset";
}

<section class="max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Send password reset", "Send this user a secure link to choose a new password.")' />

    <form asp-action="ResetUserPassword" method="post" class="rounded-card border border-line bg-surface p-6 shadow-card">
        <input asp-for="UserId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div>
        <p class="leading-6 text-muted">The current password will not be shown or changed by an administrator.</p>
        <div class="mt-7 flex gap-3">
            <a asp-controller="UserRoles" asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Primary">Send reset email</button>
        </div>
    </form>
</section>
