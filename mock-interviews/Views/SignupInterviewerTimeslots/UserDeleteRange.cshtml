@model MockInterviews.Models.ViewModels.Shared.TimeRangeViewModel

@{
    ViewData["Title"] = "Cancel interviewer availability";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Cancel interviewer availability", "This permanently removes all availability in this signup.")' />

    <partial name="DesignSystem/_Feedback"
             model='new UiFeedbackViewModel(UiFeedbackKind.Warning, "Confirm cancellation", "This action cannot be undone.")' />

    <form asp-action="UserDeleteRangeConfirmed" class="flex flex-wrap items-center gap-4">
        <input type="hidden" name="id" value="@Model.SignupInterviewerId" />
        <button type="submit" ui-variant="Primary" class="bg-negative hover:bg-negative/90 focus-visible:outline-negative">Cancel availability</button>
        <a asp-controller="Home" asp-action="Index" class="text-sm font-semibold text-ink hover:underline">Keep availability</a>
    </form>
</section>
