@model MockInterviews.Models.Entities.InterviewerTimeslot

@{
    ViewData["Title"] = "Availability details";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-3xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Availability details", "Review this interviewer’s 30-minute availability block.")' />

    <dl class="grid gap-px overflow-hidden rounded-card border border-line bg-line shadow-card sm:grid-cols-2">
        <div class="bg-surface p-5">
            <dt class="text-sm text-muted">Interviewer</dt>
            <dd class="mt-1 font-semibold text-ink">@Model.InterviewerSignup.FirstName @Model.InterviewerSignup.LastName</dd>
        </div>
        <div class="bg-surface p-5">
            <dt class="text-sm text-muted">Time</dt>
            <dd class="mt-1 font-semibold text-ink">@Model.Timeslot.Event.Date.ToString("MMM d, yyyy") · @Model.Timeslot.Time.ToString("h:mm tt")</dd>
        </div>
        <div class="bg-surface p-5">
            <dt class="text-sm text-muted">Interview types</dt>
            <dd class="mt-1 font-semibold text-ink">@Model.InterviewerSignup.Type</dd>
        </div>
        <div class="bg-surface p-5">
            <dt class="text-sm text-muted">Preference</dt>
            <dd class="mt-1 font-semibold text-ink">@(Model.InterviewerSignup.InPerson ? "In person" : "Virtual")</dd>
        </div>
    </dl>

    <a asp-action="Index" ui-variant="Quiet">Back to availability</a>
</section>
