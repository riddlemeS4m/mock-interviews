@model MockInterviews.Models.Entities.InterviewerTimeslot

@{
    ViewData["Title"] = "Cancel availability";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-2xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Cancel availability", "This removes one selected 30-minute availability block.")' />

    <div class="rounded-card border border-line bg-surface p-6 shadow-card">
        <p class="text-ink">
            <span class="font-semibold">@Model.InterviewerSignup.FirstName @Model.InterviewerSignup.LastName</span>
            · @Model.Timeslot.Event.Date.ToString("MMM d, yyyy") at @Model.Timeslot.Time.ToString("h:mm tt")
        </p>

        <form asp-action="Delete" method="post" class="mt-6 flex gap-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" ui-variant="Destructive">Cancel availability</button>
            <a asp-action="Index" ui-variant="Quiet">Keep it</a>
        </form>
    </div>
</section>
