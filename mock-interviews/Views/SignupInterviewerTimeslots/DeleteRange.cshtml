@model MockInterviews.Models.ViewModels.Shared.TimeRangeViewModel

@{
    ViewData["Title"] = "Cancel interviewer availability";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-2xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Cancel interviewer availability", "Confirm removal of this contiguous availability range.")' />

    <div class="rounded-card border border-line bg-surface p-6 shadow-card">
        <p class="text-ink">@Model.Date.ToString("MMMM d, yyyy") · @Model.StartTime–@Model.EndTime</p>

        <form asp-action="DeleteRangeConfirmed" method="post" class="mt-6 flex gap-3">
            @foreach (var id in Model.TimeslotIds)
            {
                <input type="hidden" name="timeslots" value="@id" />
            }
            <button type="submit" ui-variant="Destructive">Cancel availability</button>
            <a asp-action="Index" ui-variant="Quiet">Keep it</a>
        </form>
    </div>
</section>
