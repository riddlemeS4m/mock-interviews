@model MockInterviews.Models.ViewModels.SignupInterviewerTimeslotsController.SignupInterviewerTimeslotsViewModel

@{
    ViewData["Title"] = "Add interviewer availability";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-5xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Add interviewer availability", "Select an interviewer, their interview preferences, and every 30-minute time they can offer.")' />

    @if (Model.EventDays.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new UiEmptyStateViewModel("calendar-days", "No interviewer times available", "There are no active interviewer times available right now.")' />
    }
    else
    {
        <form asp-action="CreateForInterviewer" method="post" class="space-y-8" data-interviewer-form>
            <div asp-validation-summary="All" class="border-l-4 border-l-negative pl-4 text-sm text-negative"></div>

            <div class="rounded-card border border-line bg-surface p-5 shadow-card sm:p-6">
                <label asp-for="InterviewerId" class="block text-sm font-semibold text-ink">Interviewer</label>
                <select asp-for="InterviewerId" asp-items="Model.Interviewers" class="mt-2 block min-h-11 w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm sm:max-w-xl">
                    <option value="">Select an interviewer</option>
                </select>
                <span asp-validation-for="InterviewerId" class="mt-1 block text-sm text-negative"></span>
            </div>

            <div class="grid gap-6 lg:grid-cols-2">
                <fieldset class="rounded-card border border-line bg-surface p-5 shadow-card">
                    <legend class="font-semibold text-ink">Interview location</legend>
                    <div class="mt-4 grid gap-3 sm:grid-cols-2">
                        <label for="manual-location-in-person" class="flex cursor-pointer items-start gap-3 rounded-md border border-line p-4 has-[:checked]:border-ink has-[:checked]:bg-soft">
                            <input id="manual-location-in-person" type="radio" name="SignupInterviewer.InPerson" value="true" checked="@(Model.SignupInterviewer.InPerson ? "checked" : null)" class="mt-1 size-4" data-location-mode />
                            <span><span class="block font-semibold text-ink">In person</span><span class="mt-1 block text-sm text-muted">Meet students on site.</span></span>
                        </label>
                        <label for="manual-location-virtual" class="flex cursor-pointer items-start gap-3 rounded-md border border-line p-4 has-[:checked]:border-ink has-[:checked]:bg-soft">
                            <input id="manual-location-virtual" type="radio" name="SignupInterviewer.InPerson" value="false" checked="@(!Model.SignupInterviewer.InPerson ? "checked" : null)" class="mt-1 size-4" data-location-mode />
                            <span><span class="block font-semibold text-ink">Virtual</span><span class="mt-1 block text-sm text-muted">Meet students remotely.</span></span>
                        </label>
                    </div>
                    <span asp-validation-for="SignupInterviewer.InPerson" class="mt-2 block text-sm text-negative"></span>
                    <label class="mt-5 flex items-start gap-3" data-lunch-option>
                        <input type="checkbox" name="Lunch" value="true" checked="@(Model.Lunch ? "checked" : null)" class="mt-1 size-4" />
                        <span><span class="block font-semibold text-ink">Lunch requested</span><span class="mt-1 block text-sm text-muted">Available only for in-person interviewers.</span></span>
                    </label>
                </fieldset>

                <fieldset class="rounded-card border border-line bg-surface p-5 shadow-card">
                    <legend class="font-semibold text-ink">Interview types</legend>
                    <p class="mt-1 text-sm text-muted">Choose every type the interviewer can conduct.</p>
                    <div class="mt-4 space-y-3">
                        <label class="flex items-center gap-3"><input asp-for="SignupInterviewer.IsTechnical" class="size-4" /><span class="font-medium text-ink">Technical</span></label>
                        <label class="flex items-center gap-3"><input asp-for="SignupInterviewer.IsBehavioral" class="size-4" /><span class="font-medium text-ink">Behavioral</span></label>
                        <label class="flex items-center gap-3"><input asp-for="SignupInterviewer.IsCase" class="size-4" /><span class="font-medium text-ink">Case</span></label>
                    </div>
                    <span asp-validation-for="SignupInterviewer.IsTechnical" class="mt-2 block text-sm text-negative"></span>
                </fieldset>
            </div>

            <partial name="ParticipantScheduling/_EventDayTimeslotSelector"
                     model='new TimeslotSelectorViewModel(Model.EventDays, "SelectedTimeslotIds", true, true, "manual-interviewer-timeslot")' />

            <div class="flex flex-wrap items-center gap-3">
                <button type="submit" ui-variant="Primary">Save interviewer availability</button>
                <a asp-controller="SignupInterviewers" asp-action="Index" ui-variant="Quiet">Back to interviewer check-in</a>
            </div>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/timeslot-selection.js" asp-append-version="true"></script>
    <script src="~/js/interviewer-availability.js" asp-append-version="true"></script>
}
