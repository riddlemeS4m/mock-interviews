@model MockInterviews.Models.ViewModels.SignupInterviewerTimeslotsController.SignupInterviewerTimeslotsViewModel

@{
    ViewData["Title"] = "Interviewer availability";
    Layout = User.Identity?.IsAuthenticated == true
        ? "/Views/Shared/_TailwindLayout.cshtml"
        : "/Views/Shared/_TailwindPublicLayout.cshtml";
}

<section class="mx-auto max-w-5xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Interviewer availability", "Tell us how you would like to interview and select every 30-minute time you can offer.")' />

    @if (Model.SignedUp || Model.EventDays.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState" model='new UiEmptyStateViewModel("calendar-days", "No availability to add", "There are no eligible interviewer times available right now.")' />
    }
    else
    {
        <form asp-action="Create" class="space-y-8" data-interviewer-form>
            <div asp-validation-summary="All" class="border-l-4 border-l-negative pl-4 text-sm text-negative"></div>

            <div class="grid gap-6 rounded-card border border-line bg-surface p-5 shadow-card sm:grid-cols-2 sm:p-6">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-semibold text-ink">First name</label>
                    <input asp-for="FirstName" autocomplete="given-name" class="mt-2 block min-h-11 w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm" />
                    <span asp-validation-for="FirstName" class="mt-1 block text-sm text-negative"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm font-semibold text-ink">Last name</label>
                    <input asp-for="LastName" autocomplete="family-name" class="mt-2 block min-h-11 w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm" />
                    <span asp-validation-for="LastName" class="mt-1 block text-sm text-negative"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-sm font-semibold text-ink">Email</label>
                    <input asp-for="Email" type="email" autocomplete="email" class="mt-2 block min-h-11 w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm" />
                    <span asp-validation-for="Email" class="mt-1 block text-sm text-negative"></span>
                </div>
                <div>
                    <label asp-for="Company" class="block text-sm font-semibold text-ink">Company</label>
                    <input asp-for="Company" autocomplete="organization" class="mt-2 block min-h-11 w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm" />
                    <span asp-validation-for="Company" class="mt-1 block text-sm text-negative"></span>
                </div>
            </div>

            <div class="grid gap-6 lg:grid-cols-2">
                <fieldset class="rounded-card border border-line bg-surface p-5 shadow-card">
                    <legend class="font-semibold text-ink">Interview location</legend>
                    <div class="mt-4 grid gap-3 sm:grid-cols-2">
                        <label for="location-in-person" class="flex cursor-pointer items-start gap-3 rounded-md border border-line p-4 has-[:checked]:border-ink has-[:checked]:bg-soft">
                            <input id="location-in-person" type="radio" name="SignupInterviewer.InPerson" value="true" checked="@(Model.SignupInterviewer.InPerson ? "checked" : null)" class="mt-1 size-4" data-location-mode />
                            <span><span class="block font-semibold text-ink">In person</span><span class="mt-1 block text-sm text-muted">Meet students on site.</span></span>
                        </label>
                        <label for="location-virtual" class="flex cursor-pointer items-start gap-3 rounded-md border border-line p-4 has-[:checked]:border-ink has-[:checked]:bg-soft">
                            <input id="location-virtual" type="radio" name="SignupInterviewer.InPerson" value="false" checked="@(!Model.SignupInterviewer.InPerson ? "checked" : null)" class="mt-1 size-4" data-location-mode />
                            <span><span class="block font-semibold text-ink">Virtual</span><span class="mt-1 block text-sm text-muted">Meet students remotely.</span></span>
                        </label>
                    </div>
                    <span asp-validation-for="SignupInterviewer.InPerson" class="mt-2 block text-sm text-negative"></span>
                    <label class="mt-5 flex items-start gap-3" data-lunch-option>
                        <input type="checkbox" name="Lunch" value="true" checked="@(Model.Lunch ? "checked" : null)" class="mt-1 size-4" />
                        <span><span class="block font-semibold text-ink">Lunch requested</span><span class="mt-1 block text-sm text-muted">Available only for in-person interviewers.</span></span>
                    </label>
                </fieldset>

                <fieldset class="rounded-card border border-line bg-surface p-5 shadow-card">
                    <legend class="font-semibold text-ink">Interview types</legend>
                    <p class="mt-1 text-sm text-muted">Choose every type you are comfortable conducting.</p>
                    <div class="mt-4 space-y-3">
                        <label class="flex items-center gap-3"><input asp-for="SignupInterviewer.IsTechnical" class="size-4" /><span class="font-medium text-ink">Technical</span></label>
                        <label class="flex items-center gap-3"><input asp-for="SignupInterviewer.IsBehavioral" class="size-4" /><span class="font-medium text-ink">Behavioral</span></label>
                        <label class="flex items-center gap-3"><input asp-for="SignupInterviewer.IsCase" class="size-4" /><span class="font-medium text-ink">Case</span></label>
                    </div>
                    <span asp-validation-for="SignupInterviewer.IsTechnical" class="mt-2 block text-sm text-negative"></span>
                </fieldset>
            </div>

            <partial name="ParticipantScheduling/_EventDayTimeslotSelector"
                     model='new TimeslotSelectorViewModel(Model.EventDays, "SelectedTimeslotIds", true, true, "interviewer-timeslot")' />
            <button type="submit" ui-variant="Primary">Save interviewer availability</button>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/timeslot-selection.js" asp-append-version="true"></script>
    <script src="~/js/interviewer-availability.js" asp-append-version="true"></script>
}
