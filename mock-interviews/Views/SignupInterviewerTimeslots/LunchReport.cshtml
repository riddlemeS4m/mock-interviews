@model MockInterviews.Models.ViewModels.SignupInterviewerTimeslotsController.LunchReportViewModel

@{
    ViewData["Title"] = "Lunch report";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Lunch report", "Interviewer lunch preferences for each active non-MIS 221 event.")' />

    @if (Model.LunchReports.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new MockInterviews.Models.ViewModels.Shared.UiEmptyStateViewModel("users", "No interviewer availability", "Lunch preferences will appear here after interviewers sign up.")' />
    }
    else
    {
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var total in Model.LunchTotals)
            {
                <article class="rounded-card border border-line bg-surface p-5 shadow-card">
                    <p class="text-sm font-semibold text-muted">@total.EventName</p>
                    <p class="mt-1 text-sm text-muted">@total.Date.ToString("MMM d, yyyy")</p>
                    <p class="mt-4 text-3xl font-semibold text-ink">@total.Count</p>
                    <p class="text-sm text-muted">lunches needed</p>
                </article>
            }
        </div>

        <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
            <div class="overflow-x-auto">
                <table class="min-w-full text-left">
                    <thead class="border-b border-line bg-soft text-sm text-muted">
                        <tr>
                            <th class="px-5 py-3 font-semibold">Interviewer</th>
                            <th class="px-5 py-3 font-semibold">Lunch</th>
                            <th class="px-5 py-3 font-semibold">Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var lunch in Model.LunchReports)
                        {
                            <tr>
                                <th scope="row" class="px-5 py-4 font-semibold text-ink">@lunch.Name</th>
                                <td class="px-5 py-4 text-muted">@(lunch.LunchDesire ? "Requested" : "Not requested")</td>
                                <td class="px-5 py-4 text-muted">@lunch.ForDate.ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
