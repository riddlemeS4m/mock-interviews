@model IEnumerable<MockInterviews.Models.ViewModels.Shared.TimeRangeViewModel>

@{
    ViewData["Title"] = "Interviewer availability";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="space-y-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <partial name="DesignSystem/_PageHeader"
                 model='new UiPageHeaderViewModel("Interviewer availability", "Review active interviewer availability in exact 30-minute blocks.")' />
        <a asp-action="CreateForInterviewer" ui-variant="Primary">
            <ui-icon name="plus" class="size-4" />
            Add availability
        </a>
    </div>

    @if (!Model.Any())
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new UiEmptyStateViewModel("calendar-days", "No interviewer availability", "Active interviewer availability will appear here.")' />
    }
    else
    {
        <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
            <div class="overflow-x-auto">
                <table class="min-w-full text-left">
                    <thead class="border-b border-line bg-soft text-sm text-muted">
                        <tr>
                            <th class="px-5 py-3 font-semibold">Interviewer</th>
                            <th class="px-5 py-3 font-semibold">Types</th>
                            <th class="px-5 py-3 font-semibold">Preference</th>
                            <th class="px-5 py-3 font-semibold">Lunch</th>
                            <th class="px-5 py-3 font-semibold">Date and time</th>
                            <th class="px-5 py-3"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row" class="px-5 py-4 font-semibold text-ink">@item.Name</th>
                                <td class="px-5 py-4 text-muted">@item.InterviewType</td>
                                <td class="px-5 py-4 text-muted">@item.Location</td>
                                <td class="px-5 py-4 text-muted">@(item.WantsLunch == true ? "Requested" : "—")</td>
                                <td class="px-5 py-4 text-muted">@item.Date.ToString("MMM d, yyyy") · @item.StartTime–@item.EndTime</td>
                                <td class="px-5 py-4 text-right">
                                    <form asp-action="DeleteRange" method="get">
                                        @foreach (var id in item.TimeslotIds)
                                        {
                                            <input type="hidden" name="timeslots" value="@id" />
                                        }
                                        <button type="submit" class="text-sm font-semibold text-negative hover:underline">Cancel</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
