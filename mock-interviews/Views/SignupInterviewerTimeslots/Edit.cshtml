@model MockInterviews.Models.ViewModels.SignupInterviewerTimeslotsController.SignupInterviewerTimeslotsViewModel

@{
    ViewData["Title"] = "Edit interviewer availability";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-5xl space-y-8">
    <partial name="DesignSystem/_PageHeader" model='new UiPageHeaderViewModel("Edit interviewer availability", "Update your interview formats, location preference, and individual 30-minute availability blocks.")' />
    <form asp-action="Edit" class="space-y-8" data-interviewer-form>
        <div asp-validation-summary="All" class="border-l-4 border-l-negative pl-4 text-sm text-negative"></div>
        <input asp-for="SignupInterviewer.Id" type="hidden" />
        <input asp-for="SignupInterviewer.InterviewerId" type="hidden" />
        <div class="grid gap-6 lg:grid-cols-2">
            <fieldset class="rounded-card border border-line bg-surface p-5 shadow-card"><legend class="font-semibold text-ink">Interview location</legend><div class="mt-4 grid gap-3 sm:grid-cols-2"><label for="edit-location-in-person" class="flex cursor-pointer items-start gap-3 rounded-md border border-line p-4 has-[:checked]:border-ink has-[:checked]:bg-soft"><input id="edit-location-in-person" type="radio" name="SignupInterviewer.InPerson" value="true" checked="@(Model.SignupInterviewer.InPerson ? "checked" : null)" class="mt-1 size-4" data-location-mode /><span class="font-semibold text-ink">In person</span></label><label for="edit-location-virtual" class="flex cursor-pointer items-start gap-3 rounded-md border border-line p-4 has-[:checked]:border-ink has-[:checked]:bg-soft"><input id="edit-location-virtual" type="radio" name="SignupInterviewer.InPerson" value="false" checked="@(!Model.SignupInterviewer.InPerson ? "checked" : null)" class="mt-1 size-4" data-location-mode /><span class="font-semibold text-ink">Virtual</span></label></div><label class="mt-5 flex items-start gap-3" data-lunch-option><input type="checkbox" name="Lunch" value="true" checked="@(Model.Lunch ? "checked" : null)" class="mt-1 size-4" /><span><span class="block font-semibold text-ink">Lunch requested</span><span class="mt-1 block text-sm text-muted">Available only for in-person interviewers.</span></span></label></fieldset>
            <fieldset class="rounded-card border border-line bg-surface p-5 shadow-card"><legend class="font-semibold text-ink">Interview types</legend><div class="mt-4 space-y-3"><label class="flex items-center gap-3"><input asp-for="SignupInterviewer.IsTechnical" class="size-4" /><span class="font-medium text-ink">Technical</span></label><label class="flex items-center gap-3"><input asp-for="SignupInterviewer.IsBehavioral" class="size-4" /><span class="font-medium text-ink">Behavioral</span></label><label class="flex items-center gap-3"><input asp-for="SignupInterviewer.IsCase" class="size-4" /><span class="font-medium text-ink">Case</span></label></div><span asp-validation-for="SignupInterviewer.IsTechnical" class="mt-2 block text-sm text-negative"></span></fieldset>
        </div>
        <partial name="ParticipantScheduling/_EventDayTimeslotSelector"
                 model='new TimeslotSelectorViewModel(Model.EventDays, "SelectedTimeslotIds", true, true, "edit-interviewer-timeslot")' />
        <div class="flex flex-wrap items-center gap-4"><button type="submit" ui-variant="Primary">Save availability</button><a asp-controller="Home" asp-action="Index" class="text-sm font-semibold text-ink hover:underline">Cancel</a></div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/timeslot-selection.js" asp-append-version="true"></script><script src="~/js/interviewer-availability.js" asp-append-version="true"></script> }
