@using MockInterviews.Models.Entities
@model Location

@{
    ViewData["Title"] = "Delete room";
}

<section class="max-w-3xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Delete room?", "Review the room before permanently removing it.")' />

    <div class="rounded-card border border-line border-l-4 border-l-negative bg-surface p-6 shadow-card sm:p-8">
        <h2 class="text-xl font-semibold text-ink">@Model.Room</h2>
        <p class="mt-2 leading-6 text-muted">This room will no longer be available for assignments. This cannot be undone.</p>

        <dl class="mt-6 divide-y divide-line rounded-lg border border-line">
            <div class="grid gap-1 px-4 py-3 sm:grid-cols-[12rem_1fr] sm:gap-6">
                <dt class="text-sm font-medium text-muted">Virtual interviewers</dt>
                <dd class="text-ink">@(Model.IsVirtual ? "Supported" : "Not supported")</dd>
            </div>
            <div class="grid gap-1 px-4 py-3 sm:grid-cols-[12rem_1fr] sm:gap-6">
                <dt class="text-sm font-medium text-muted">In-person interviewers</dt>
                <dd class="text-ink">@(Model.InPerson ? "Supported" : "Not supported")</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="mt-8 flex flex-wrap justify-end gap-3 border-t border-line pt-6">
            <input asp-for="Id" type="hidden" />
            <a asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Destructive">
                <ui-icon name="trash-2" class="size-4" />
                Delete room
            </button>
        </form>
    </div>
</section>
