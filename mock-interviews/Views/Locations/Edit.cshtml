@using MockInterviews.Models.Entities
@model Location

@{
    ViewData["Title"] = "Edit room";
    ViewData["FieldIdPrefix"] = "location-edit-page";
}

<section class="max-w-3xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel($"Edit {Model.Room}", "Update the room name or supported interview formats.")' />

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="rounded-card border border-line bg-surface p-6 shadow-card sm:p-8">
        <input asp-for="Id" type="hidden" />
        <partial name="_FormFields" model="Model" />
        <div class="mt-8 flex flex-wrap justify-end gap-3 border-t border-line pt-6">
            <a asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Primary">Save changes</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
