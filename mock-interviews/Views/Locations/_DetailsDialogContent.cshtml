<dl class="divide-y divide-line rounded-lg border border-line">
    <div class="px-4 py-3">
        <dt class="text-sm font-medium text-muted">Room or location</dt>
        <dd class="mt-1 font-semibold text-ink" data-dialog-field="room"></dd>
    </div>
    <div class="px-4 py-3">
        <dt class="text-sm font-medium text-muted">Virtual interviewers</dt>
        <dd class="mt-1 text-ink" data-dialog-field="virtual-label"></dd>
    </div>
    <div class="px-4 py-3">
        <dt class="text-sm font-medium text-muted">In-person interviewers</dt>
        <dd class="mt-1 text-ink" data-dialog-field="in-person-label"></dd>
    </div>
</dl>

<div class="mt-7 flex justify-end">
    <button type="button" ui-variant="Secondary" data-dialog-close>Close</button>
</div>
