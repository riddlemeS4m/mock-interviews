@using MockInterviews.Models.Entities
@model Location

@{
    ViewData["Title"] = "Add room";
    ViewData["FieldIdPrefix"] = "location-create-page";
}

<section class="max-w-3xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Add room", "Create a room or virtual location for interview assignments.")' />

    <form asp-action="Create" method="post" class="rounded-card border border-line bg-surface p-6 shadow-card sm:p-8">
        <partial name="_FormFields" model="Model" />
        <div class="mt-8 flex flex-wrap justify-end gap-3 border-t border-line pt-6">
            <a asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Primary">Add room</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
