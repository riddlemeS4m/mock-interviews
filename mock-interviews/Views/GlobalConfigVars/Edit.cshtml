@model MockInterviews.Models.ViewModels.GlobalConfigVarsController.ConfigurationEditViewModel

@{
    ViewData["Title"] = "Edit configuration";
}

<section class="max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Edit configuration", "Update the value without changing the setting key.")' />

    <form asp-action="Edit" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-card">
        <input asp-for="Id" type="hidden" />
        <input asp-for="Name" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div>

        <p class="font-mono text-sm font-semibold text-ink">@Model.Name</p>

        <div>
            <label asp-for="Value" class="block text-sm font-semibold text-ink"></label>
            <input asp-for="Value" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2" />
            <span asp-validation-for="Value" class="text-sm text-negative"></span>
        </div>

        <div class="flex gap-3">
            <a asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Primary">Save value</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
