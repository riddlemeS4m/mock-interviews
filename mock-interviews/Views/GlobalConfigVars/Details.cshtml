@model MockInterviews.Models.Entities.Setting

@{
    ViewData["Title"] = "Configuration details";
}

<section class="max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Configuration details", "Review this setting’s current value.")' />

    <dl class="divide-y divide-line rounded-card border border-line bg-surface shadow-card">
        <div class="p-5">
            <dt class="text-sm text-muted">Setting</dt>
            <dd class="mt-1 break-all font-mono font-semibold text-ink">@Model.Name</dd>
        </div>
        <div class="p-5">
            <dt class="text-sm text-muted">Value</dt>
            <dd class="mt-1 break-all text-ink">@Model.Value</dd>
        </div>
    </dl>

    <div class="flex gap-3">
        <a asp-action="Index" ui-variant="Secondary">Back</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" ui-variant="Primary">Edit</a>
    </div>
</section>
