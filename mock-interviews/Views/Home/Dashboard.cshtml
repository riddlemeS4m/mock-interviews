@model DashboardViewModel

@{
    ViewData["Title"] = "My schedule";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<div class="space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel($"Hi, {Model.DisplayName}", "Here is your current interview and volunteer schedule.")' />

    @if (Model.ShowServiceDisruption)
    {
        <partial name="DesignSystem/_Feedback"
                 model='new UiFeedbackViewModel(UiFeedbackKind.Warning, "Service disruption", "Some Mock Interviews features are temporarily unavailable. Please try again shortly.")' />
    }

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <partial name="DesignSystem/_Feedback"
                 model="new UiFeedbackViewModel(UiFeedbackKind.Success, statusMessage, string.Empty)" />
    }

    @if (Model.Meeting is not null)
    {
        <aside class="rounded-card border border-line bg-surface p-5 shadow-card sm:flex sm:items-center sm:justify-between sm:gap-6">
            <div class="flex gap-3">
                <ui-icon name="link" class="mt-0.5 size-5 shrink-0 text-muted" />
                <div>
                    <p class="font-semibold text-ink">Virtual interview room</p>
                    <p class="mt-1 text-sm leading-6 text-muted">Use this meeting link when it is time for your virtual interview.</p>
                </div>
            </div>
            <a href="@Model.Meeting.Url"
               target="_blank"
               rel="noopener"
               ui-variant="Primary"
               class="mt-4 w-full shrink-0 sm:mt-0 sm:w-auto">
                Join meeting
                <ui-icon name="external-link" class="size-4" />
            </a>
        </aside>
    }

    @if (Model.Student is not null)
    {
        <partial name="DashboardPartials/_StudentInterviews" model="Model.Student.Interviews" />
        <partial name="DashboardPartials/_VolunteerSchedule" model="Model.Student.VolunteerShifts" />
    }

    @if (Model.Interviewer is not null)
    {
        <partial name="DashboardPartials/_ActiveInterviews" model="Model.Interviewer.ActiveInterviews" />
        <partial name="DashboardPartials/_InterviewerSchedule" model="Model.Interviewer.ScheduleGroups" />
        <partial name="DashboardPartials/_CompletedInterviews" model="Model.Interviewer.CompletedInterviews" />
    }

    <partial name="DashboardPartials/_ParticipantDialogs" />
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
