@model IReadOnlyList<CompletedInterviewViewModel>

<section aria-labelledby="completed-interviews-heading">
    <div class="mb-3 flex items-center gap-3">
        <ui-icon name="circle-check" class="size-5 text-muted" />
        <h2 id="completed-interviews-heading" class="text-xl font-semibold text-ink">Completed interviews</h2>
    </div>

    @if (Model.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new UiEmptyStateViewModel("circle-check", "No completed interviews", "Completed interviews will move here from your active list.")' />
    }
    else
    {
        <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-line text-left text-sm">
                    <thead class="bg-soft/60 text-xs font-semibold uppercase tracking-wide text-muted">
                        <tr>
                            <th scope="col" class="px-5 py-3">Date and time</th>
                            <th scope="col" class="px-5 py-3">Student</th>
                            <th scope="col" class="px-5 py-3">Type</th>
                            <th scope="col" class="px-5 py-3"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var interview in Model)
                        {
                            <tr>
                                <td class="whitespace-nowrap px-5 py-4">
                                    <time datetime="@interview.Date.ToString("yyyy-MM-dd")" class="font-medium text-ink">@interview.Date.ToString("MMM d, yyyy")</time>
                                    <span class="block text-muted">@interview.Time.ToString("h:mm tt")</span>
                                </td>
                                <td class="px-5 py-4 text-ink">@interview.StudentName</td>
                                <td class="px-5 py-4 text-ink">@interview.InterviewType</td>
                                <td class="whitespace-nowrap px-5 py-4 text-right">
                                    <a asp-controller="Users"
                                       asp-action="ExternalUserProfileView"
                                       asp-route-userId="@interview.StudentId"
                                       class="font-semibold text-ink hover:underline">View profile</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
