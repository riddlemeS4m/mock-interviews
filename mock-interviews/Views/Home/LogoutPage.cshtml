@{
    ViewData["Title"] = "Signing out";
}

<section class="mx-auto max-w-xl py-10 text-center">
    <ui-icon name="log-out" class="mx-auto size-10 text-muted" />
    <h1 class="mt-5 text-3xl font-bold tracking-tight text-ink">Signing you out</h1>
    <p class="mt-3 text-muted">Please wait while we securely end your session.</p>
</section>

<form id="external-logout-form"
      asp-area="Identity"
      asp-page="/Account/Logout"
      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
      method="post"></form>

@section Scripts {
    <script src="~/js/logout.js" asp-append-version="true"></script>
}
