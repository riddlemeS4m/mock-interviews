@model PublicHomeViewModel

@{
    ViewData["Title"] = "Mock Interviews";
    Layout = "/Views/Shared/_TailwindPublicLayout.cshtml";
}

<div class="space-y-10">
    @if (Model.ShowServiceDisruption)
    {
        <partial name="DesignSystem/_Feedback"
                 model='new UiFeedbackViewModel(UiFeedbackKind.Warning, "Service disruption", "Some Mock Interviews features are temporarily unavailable. Please try again shortly.")' />
    }

    <section class="grid items-center gap-10 lg:grid-cols-2">
        <div class="max-w-3xl">
            <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">Prepare for the conversation that comes next.</h1>
            <p class="mt-5 text-xl leading-8 text-muted">Mock Interviews brings students, interviewers, and event teams together to schedule and run practice interviews.</p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a asp-area="Identity" asp-page="/Account/Login" ui-variant="Primary">Sign in</a>
                <a asp-area="Identity" asp-page="/Account/Register" ui-variant="Secondary">Create account</a>
                <a asp-controller="FAQs" asp-action="Resources" ui-variant="Quiet">View resources</a>
            </div>
        </div>

        <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
            <img src="~/images/02_7.jpg"
                 alt="Hewson Hall in the spring"
                 class="h-full min-h-[22rem] w-full object-cover" />
        </div>
    </section>
</div>
