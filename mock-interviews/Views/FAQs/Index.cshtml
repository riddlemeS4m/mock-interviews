@using MockInterviews.Models.ViewModels.FAQsController
@using MockInterviews.Models.ViewModels.Shared
@model FaqIndexViewModel

@{
    ViewData["Title"] = "Manage FAQs";
}

<section class="space-y-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <partial name="DesignSystem/_PageHeader"
                 model='new UiPageHeaderViewModel("Manage FAQs", "Answer participant questions and maintain the public resources page.")' />
        <a asp-action="Create" ui-variant="Primary" data-dialog-target="faq-create-dialog">
            <ui-icon name="plus" class="size-4" />
            Add FAQ
        </a>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <partial name="DesignSystem/_Feedback"
                 model="new UiFeedbackViewModel(UiFeedbackKind.Success, statusMessage, string.Empty)" />
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <partial name="DesignSystem/_Feedback"
                 model="new UiFeedbackViewModel(UiFeedbackKind.Error, errorMessage, string.Empty)" />
    }

    @if (Model.Questions.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState"
                 model='new UiEmptyStateViewModel("inbox", "No questions yet", "Participant questions and administrator-authored FAQs will appear here.")' />
    }
    else
    {
        <div class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
            <div class="overflow-x-auto">
                <table class="min-w-full text-left">
                    <thead class="border-b border-line bg-soft text-sm text-muted">
                        <tr>
                            <th class="px-5 py-3 font-semibold">Question</th>
                            <th class="px-5 py-3 font-semibold">Published answer</th>
                            <th class="px-5 py-3 text-right font-semibold"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var question in Model.Questions)
                        {
                            <tr>
                                <th scope="row" class="max-w-lg px-5 py-4 font-semibold text-ink">@question.Q</th>
                                <td class="max-w-lg px-5 py-4 text-muted">@(question.A ?? "Awaiting answer")</td>
                                <td class="whitespace-nowrap px-5 py-4 text-right">
                                    <div class="inline-flex gap-4">
                                        <a asp-action="Details" asp-route-id="@question.Id" class="text-sm font-semibold text-ink hover:underline"
                                           data-dialog-target="faq-details-dialog" data-dialog-value-question="@question.Q"
                                           data-dialog-value-answer="@(question.A ?? "Awaiting answer")">View</a>
                                        <a asp-action="Edit" asp-route-id="@question.Id" class="text-sm font-semibold text-ink hover:underline">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@question.Id" class="text-sm font-semibold text-negative hover:underline"
                                           data-dialog-target="faq-delete-dialog" data-dialog-value-id="@question.Id"
                                           data-dialog-value-question="@question.Q">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

<partial name="_Dialogs" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
