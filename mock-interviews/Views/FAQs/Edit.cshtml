@model MockInterviews.Models.Entities.Question

@{
    ViewData["Title"] = "Edit FAQ";
}

<section class="mx-auto max-w-2xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Edit FAQ", "Update the question and its published answer.")' />

    <form asp-action="Edit" method="post" class="rounded-card border border-line bg-surface p-6 shadow-card">
        <input asp-for="Id" type="hidden" />
        <partial name="_FormFields" model="Model" />

        <div class="mt-7 flex gap-3">
            <a asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Primary">Save changes</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
