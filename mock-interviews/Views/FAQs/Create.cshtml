@using MockInterviews.Data.Constants
@model MockInterviews.Models.Entities.Question

@{
    ViewData["Title"] = "Ask a question";
    var canAnswer = User.IsInRole(RolesConstants.AdminRole) || User.IsInRole(RolesConstants.SystemAdminRole);
    var pageHeader = new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel(
        canAnswer ? "Add FAQ" : "Ask a question",
        canAnswer ? "Publish a new FAQ or save a question to answer later." : "Submit a question for the mock interviews team.");
}

<section class="mx-auto max-w-2xl space-y-6">
    <partial name="DesignSystem/_PageHeader" model="pageHeader" />

    <form asp-action="Create" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-card">
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div>

        <div>
            <label asp-for="Q" class="block text-sm font-semibold text-ink">Question</label>
            <textarea asp-for="Q" rows="4" class="mt-2 block w-full rounded-md border border-line px-3 py-2"></textarea>
            <span asp-validation-for="Q" class="text-sm text-negative"></span>
        </div>

        @if (canAnswer)
        {
            <div>
                <label asp-for="A" class="block text-sm font-semibold text-ink">Answer <span class="font-normal text-muted">(optional)</span></label>
                <textarea asp-for="A" rows="5" class="mt-2 block w-full rounded-md border border-line px-3 py-2"></textarea>
            </div>
        }

        <div class="flex gap-3">
            <a asp-action="Resources" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Primary">@(canAnswer ? "Save FAQ" : "Submit question")</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
