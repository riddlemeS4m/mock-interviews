@model MockInterviews.Models.Entities.Question

@{
    ViewData["Title"] = "Delete FAQ";
}

<section class="mx-auto max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Delete FAQ", "This action cannot be undone.")' />

    <div class="rounded-card border border-negative/30 bg-surface p-6 shadow-card">
        <p class="leading-6 text-muted">Permanently delete <strong class="text-ink">@Model.Q</strong>?</p>
        <form asp-action="Delete" method="post" class="mt-7 flex gap-3">
            <input asp-for="Id" type="hidden" />
            <a asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Destructive">Delete FAQ</button>
        </form>
    </div>
</section>
