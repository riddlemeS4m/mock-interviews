@model MockInterviews.Models.Entities.InterviewerSignup

@{
    ViewData["Title"] = "Delete interviewer signup";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-2xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Delete interviewer signup", "This removes the saved interviewer signup record.")' />

    <div class="rounded-card border border-line bg-surface p-6 shadow-card">
        <p class="text-ink">Delete <span class="font-semibold">@Model.FirstName @Model.LastName</span>’s signup?</p>

        <form asp-action="Delete" method="post" class="mt-6 flex gap-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" ui-variant="Destructive">Delete signup</button>
            <a asp-action="Index" ui-variant="Quiet">Keep it</a>
        </form>
    </div>
</section>
