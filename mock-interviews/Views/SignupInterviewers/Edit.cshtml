@model MockInterviews.Models.Entities.InterviewerSignup

@{
    ViewData["Title"] = "Edit interviewer";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-3xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Edit interviewer", "Update interviewer preferences and supported interview types.")' />

    <form asp-action="Edit" method="post" class="space-y-6 rounded-card border border-line bg-surface p-6 shadow-card">
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-l-negative pl-4 text-sm text-negative"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="InterviewerId" />

        <div class="grid gap-5 sm:grid-cols-2">
            <div>
                <label asp-for="FirstName" class="block text-sm font-semibold text-ink">First name</label>
                <input asp-for="FirstName" class="mt-2 min-h-11 w-full rounded-md border border-line px-3 py-2" />
                <span asp-validation-for="FirstName" class="text-sm text-negative"></span>
            </div>
            <div>
                <label asp-for="LastName" class="block text-sm font-semibold text-ink">Last name</label>
                <input asp-for="LastName" class="mt-2 min-h-11 w-full rounded-md border border-line px-3 py-2" />
                <span asp-validation-for="LastName" class="text-sm text-negative"></span>
            </div>
        </div>

        <fieldset>
            <legend class="font-semibold text-ink">Location</legend>
            <div class="mt-3 flex gap-5">
                <label class="flex items-center gap-2"><input asp-for="InPerson" class="size-4" /> In person</label>
                <label class="flex items-center gap-2"><input asp-for="IsVirtual" class="size-4" /> Virtual</label>
            </div>
        </fieldset>

        <fieldset>
            <legend class="font-semibold text-ink">Interview types</legend>
            <div class="mt-3 flex flex-wrap gap-5">
                <label class="flex items-center gap-2"><input asp-for="IsTechnical" class="size-4" /> Technical</label>
                <label class="flex items-center gap-2"><input asp-for="IsBehavioral" class="size-4" /> Behavioral</label>
            </div>
        </fieldset>

        <div class="flex gap-3">
            <button type="submit" ui-variant="Primary">Save changes</button>
            <a asp-action="Index" ui-variant="Quiet">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
