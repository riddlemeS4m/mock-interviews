@model MockInterviews.Models.ViewModels.SignupInterviewersController.SignupInterviewerViewModel

@{
    ViewData["Title"] = "Interviewer details";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
    var interviewer = Model.SignupInterviewer;
}

<section class="mx-auto max-w-3xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Interviewer details", "Review an interviewer’s active signup preferences.")' />

    <dl class="grid gap-px overflow-hidden rounded-card border border-line bg-line shadow-card sm:grid-cols-2">
        <div class="bg-surface p-5">
            <dt class="text-sm text-muted">Name</dt>
            <dd class="mt-1 font-semibold text-ink">@interviewer.FirstName @interviewer.LastName</dd>
        </div>
        <div class="bg-surface p-5">
            <dt class="text-sm text-muted">Preference</dt>
            <dd class="mt-1 font-semibold text-ink">@(interviewer.InPerson ? "In person" : "Virtual")</dd>
        </div>
        <div class="bg-surface p-5">
            <dt class="text-sm text-muted">Interview types</dt>
            <dd class="mt-1 font-semibold text-ink">@interviewer.Type</dd>
        </div>
        <div class="bg-surface p-5">
            <dt class="text-sm text-muted">Lunch</dt>
            <dd class="mt-1 font-semibold text-ink">@(interviewer.Lunch == true ? "Requested" : "Not requested")</dd>
        </div>
    </dl>

    <div class="flex gap-3">
        <a asp-action="Edit" asp-route-id="@interviewer.Id" ui-variant="Secondary">Edit</a>
        <a asp-action="Index" ui-variant="Quiet">Back to check-in</a>
    </div>
</section>
