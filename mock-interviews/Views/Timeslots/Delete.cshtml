@model MockInterviews.Models.Entities.Timeslot
@{ ViewData["Title"] = "Delete timeslot"; }
<section class="max-w-xl space-y-6"><partial name="DesignSystem/_PageHeader" model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Delete timeslot", "This action cannot be undone.")' /><div class="rounded-card border border-negative/30 bg-surface p-6 shadow-card"><p class="leading-6 text-muted">Delete the <strong class="text-ink">@Model.Time.ToString("h:mm tt")</strong> block from @Model.Event.Name? The action is blocked if related scheduling records remain.</p><form asp-action="Delete" method="post" class="mt-7 flex gap-3"><input asp-for="Id" type="hidden" /><a asp-action="Index" ui-variant="Secondary">Cancel</a><button type="submit" ui-variant="Destructive">Delete timeslot</button></form></div></section>
