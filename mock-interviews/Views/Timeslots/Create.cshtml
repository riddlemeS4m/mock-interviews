@model MockInterviews.Models.Entities.Timeslot
@{ ViewData["Title"] = "Add timeslot"; }
<section class="max-w-xl space-y-6"><partial name="DesignSystem/_PageHeader" model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Add timeslot", "Add an independent half-hour block to an active event.")' /><form asp-action="Create" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-card"><div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div><div><label asp-for="EventId" class="block text-sm font-semibold text-ink">Active event</label><select asp-for="EventId" asp-items="ViewBag.EventOptions" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2"><option value="">Choose an event</option></select><span asp-validation-for="EventId" class="text-sm text-negative"></span></div><div><label asp-for="Time" class="block text-sm font-semibold text-ink"></label><input asp-for="Time" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2" /><span asp-validation-for="Time" class="text-sm text-negative"></span></div><div><label asp-for="MaxSignUps" class="block text-sm font-semibold text-ink"></label><input asp-for="MaxSignUps" type="number" min="0" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2" /><span asp-validation-for="MaxSignUps" class="text-sm text-negative"></span></div><fieldset class="space-y-3"><legend class="text-sm font-semibold text-ink">Available for</legend><label class="flex items-center gap-3"><input asp-for="IsStudent" class="size-4" />Students</label><label class="flex items-center gap-3"><input asp-for="IsInterviewer" class="size-4" />Interviewers</label><label class="flex items-center gap-3"><input asp-for="IsVolunteer" class="size-4" />Volunteers</label></fieldset><label class="flex items-center gap-3"><input asp-for="IsActive" class="size-4" />Active</label><div class="flex gap-3"><a asp-action="Index" ui-variant="Secondary">Cancel</a><button type="submit" ui-variant="Primary">Add timeslot</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
