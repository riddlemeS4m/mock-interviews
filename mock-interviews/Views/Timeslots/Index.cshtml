@using MockInterviews.Models.ViewModels.TimeslotsController
@using MockInterviews.Models.ViewModels.Shared
@model TimeslotIndexViewModel
@{ ViewData["Title"] = "Timeslots"; }

<section class="space-y-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <partial name="DesignSystem/_PageHeader" model='new UiPageHeaderViewModel("Timeslots", "Maintain each active event’s independent half-hour availability and capacity.")' />
        <div class="flex flex-wrap gap-3"><a asp-action="UpdateMaxTimeslots" ui-variant="Secondary">Update all capacities</a><a asp-action="Create" ui-variant="Primary"><ui-icon name="plus" class="size-4" />Add timeslot</a></div>
    </div>
    @if (TempData["StatusMessage"] is string statusMessage) { <partial name="DesignSystem/_Feedback" model="new UiFeedbackViewModel(UiFeedbackKind.Success, statusMessage, string.Empty)" /> }
    @if (TempData["ErrorMessage"] is string errorMessage) { <partial name="DesignSystem/_Feedback" model="new UiFeedbackViewModel(UiFeedbackKind.Error, errorMessage, string.Empty)" /> }
    @if (Model.EventGroups.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState" model='new UiEmptyStateViewModel("clock", "No active event timeslots", "Create or activate an event date before maintaining its timeslots.")' />
    }
    else
    {
        <div class="space-y-6">
            @foreach (var group in Model.EventGroups)
            {
                <section class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
                    <div class="border-b border-line bg-soft px-5 py-4"><h2 class="font-semibold text-ink">@group.Event.Name</h2><p class="mt-1 text-sm text-muted">@group.Event.Date.ToString("dddd, MMMM d, yyyy") · @group.Timeslots.Count half-hour blocks</p></div>
                    <div class="overflow-x-auto"><table class="min-w-full text-left"><thead class="border-b border-line text-sm text-muted"><tr><th class="px-5 py-3 font-semibold">Time</th><th class="px-5 py-3 font-semibold">Capacity</th><th class="px-5 py-3 font-semibold">Available for</th><th class="px-5 py-3 text-right font-semibold"><span class="sr-only">Actions</span></th></tr></thead><tbody class="divide-y divide-line">
                        @foreach (var slot in group.Timeslots)
                        {
                            var audiences = string.Join(", ", new[] { slot.IsStudent ? "Students" : null, slot.IsInterviewer ? "Interviewers" : null, slot.IsVolunteer ? "Volunteers" : null }.Where(value => value is not null));
                            <tr><th scope="row" class="whitespace-nowrap px-5 py-4 font-semibold text-ink">@slot.Time.ToString("h:mm tt")</th><td class="px-5 py-4 text-ink">@slot.MaxSignUps</td><td class="px-5 py-4 text-muted">@(audiences.Length == 0 ? "No participant workflows" : audiences)</td><td class="whitespace-nowrap px-5 py-4 text-right"><div class="inline-flex gap-4"><a asp-action="Details" asp-route-id="@slot.Id" class="text-sm font-semibold text-ink hover:underline">View</a><a asp-action="Edit" asp-route-id="@slot.Id" class="text-sm font-semibold text-ink hover:underline">Edit</a><a asp-action="Delete" asp-route-id="@slot.Id" class="text-sm font-semibold text-negative hover:underline">Delete</a></div></td></tr>
                        }
                    </tbody></table></div>
                </section>
            }
        </div>
    }
</section>
