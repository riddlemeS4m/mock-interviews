@model MockInterviews.Models.ViewModels.TimeslotsController.TimeslotDetailsViewModel
@{ ViewData["Title"] = "Timeslot details"; }
<section class="max-w-2xl space-y-6"><partial name="DesignSystem/_PageHeader" model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Timeslot details", "Review the people currently attached to this half-hour block.")' /><dl class="divide-y divide-line rounded-card border border-line bg-surface shadow-card"><div class="p-5"><dt class="text-sm text-muted">Event</dt><dd class="mt-1 font-semibold text-ink">@Model.Timeslot.Event.Name · @Model.Timeslot.Event.Date.ToString("MMMM d, yyyy")</dd></div><div class="p-5"><dt class="text-sm text-muted">Time and capacity</dt><dd class="mt-1 text-ink">@Model.Timeslot.Time.ToString("h:mm tt") · @Model.Timeslot.MaxSignUps maximum signups</dd></div></dl><div class="grid gap-4 sm:grid-cols-3">@foreach (var group in new[] { ("Students", Model.StudentNames), ("Interviewers", Model.InterviewerNames), ("Volunteers", Model.VolunteerNames) }) { <section class="rounded-card border border-line bg-surface p-5"><h2 class="font-semibold text-ink">@group.Item1</h2>@if (group.Item2?.Count > 0) { <ul class="mt-3 space-y-2 text-sm text-muted">@foreach (var person in group.Item2) { <li>@person</li> }</ul> } else { <p class="mt-3 text-sm text-muted">None</p> }</section> }</div><div class="flex gap-3"><a asp-action="Index" ui-variant="Secondary">Back</a><a asp-action="Edit" asp-route-id="@Model.Timeslot.Id" ui-variant="Primary">Edit capacity</a></div></section>
