@model MockInterviews.Models.Entities.VolunteerTimeslot

@{
    ViewData["Title"] = "Volunteer availability details";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-2xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Volunteer availability details", "Review this selected volunteer time.")' />

    <dl class="rounded-card border border-line bg-surface p-6 shadow-card">
        <dt class="text-sm text-muted">Time</dt>
        <dd class="mt-1 font-semibold text-ink">@Model.Timeslot.Event.Date.ToString("MMMM d, yyyy") · @Model.Timeslot.Time.ToString("h:mm tt")</dd>
    </dl>

    <a asp-action="Index" ui-variant="Quiet">Back to volunteer availability</a>
</section>
