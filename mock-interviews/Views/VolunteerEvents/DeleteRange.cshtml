@model MockInterviews.Models.ViewModels.Shared.TimeRangeViewModel

@{
    ViewData["Title"] = "Cancel volunteer availability";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Cancel volunteer availability", "Confirm that you want to remove this volunteer availability.")' />

    <dl class="rounded-card border border-line bg-surface p-5 shadow-card">
        <div class="grid gap-1 border-b border-line pb-4 sm:grid-cols-2">
            <dt class="font-semibold text-ink">Volunteer</dt>
            <dd class="text-muted">@Model.Name</dd>
        </div>
        <div class="mt-4 grid gap-1 border-b border-line pb-4 sm:grid-cols-2">
            <dt class="font-semibold text-ink">Date</dt>
            <dd class="text-muted">@Model.Date.ToString("MMM d, yyyy")</dd>
        </div>
        <div class="mt-4 grid gap-1 sm:grid-cols-2">
            <dt class="font-semibold text-ink">Time</dt>
            <dd class="text-muted">@Model.StartTime–@Model.EndTime</dd>
        </div>
    </dl>

    <form asp-action="DeleteRangeConfirmed" method="post" class="flex flex-wrap items-center gap-4">
        @for (var index = 0; index < Model.TimeslotIds.Count; index++)
        {
            <input type="hidden" name="timeslots[@index]" value="@Model.TimeslotIds[index]" />
        }
        <button type="submit" ui-variant="Destructive">
            <ui-icon name="trash-2" class="size-4" />
            Cancel availability
        </button>
        <a asp-action="Index" ui-variant="Secondary">Keep availability</a>
    </form>
</section>
