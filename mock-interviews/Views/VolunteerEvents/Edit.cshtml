@model MockInterviews.Models.Entities.VolunteerTimeslot

@{
    ViewData["Title"] = "Edit volunteer availability";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-2xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Edit volunteer availability", "Update the selected volunteer time.")' />

    <form asp-action="Edit" method="post" class="space-y-6 rounded-card border border-line bg-surface p-6 shadow-card">
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-l-negative pl-4 text-sm text-negative"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="StudentId" />

        <div>
            <label asp-for="TimeslotId" class="block text-sm font-semibold text-ink">Timeslot</label>
            <select asp-for="TimeslotId" asp-items="ViewBag.TimeslotId" class="mt-2 min-h-11 w-full rounded-md border border-line px-3 py-2"></select>
            <span asp-validation-for="TimeslotId" class="text-sm text-negative"></span>
        </div>

        <div class="flex gap-3">
            <button type="submit" ui-variant="Primary">Save changes</button>
            <a asp-action="Index" ui-variant="Quiet">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
