@model MockInterviews.Models.ViewModels.VolunteerEventsController.VolunteerEventSignupViewModel

@{
    ViewData["Title"] = "Volunteer availability";
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="mx-auto max-w-5xl space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Volunteer availability", "Choose every 30-minute volunteer time that works for you.")' />

    @if (Model.SignedUp || Model.EventDays.Count == 0)
    {
        <partial name="DesignSystem/_EmptyState" model='new UiEmptyStateViewModel("users", "No volunteer times available", "You have already selected all available volunteer times, or there are no open times right now.")' />
    }
    else
    {
        <form asp-action="Create" class="space-y-6">
            <div asp-validation-summary="All" class="border-l-4 border-l-negative pl-4 text-sm text-negative"></div>
            <partial name="ParticipantScheduling/_EventDayTimeslotSelector"
                     model='new TimeslotSelectorViewModel(Model.EventDays, "SelectedTimeslotIds", true, true, "volunteer-timeslot")' />
            <button type="submit" ui-variant="Primary">Save volunteer availability</button>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/timeslot-selection.js" asp-append-version="true"></script>
}
