@model MockInterviews.Models.ViewModels.EventDatesController.EventDateEditViewModel
@{ ViewData["Title"] = "Edit event date"; }
<section class="max-w-2xl space-y-6"><partial name="DesignSystem/_PageHeader" model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Edit event date", "Update the event’s date, audience, and availability.")' /><form asp-action="Edit" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-card"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div><div><label asp-for="Date" class="block text-sm font-semibold text-ink"></label><input asp-for="Date" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2" /><span asp-validation-for="Date" class="text-sm text-negative"></span></div><div><label asp-for="Name" class="block text-sm font-semibold text-ink"></label><input asp-for="Name" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2" /><span asp-validation-for="Name" class="text-sm text-negative"></span></div><fieldset class="space-y-3"><legend class="text-sm font-semibold text-ink">Eligible students</legend><label class="flex items-center gap-3"><input asp-for="For221True" type="checkbox" class="size-4 rounded border-line" />MIS 221</label><label class="flex items-center gap-3"><input asp-for="For221False" type="checkbox" class="size-4 rounded border-line" />MIS 321 and above</label><span asp-validation-for="For221True" class="text-sm text-negative"></span></fieldset><label class="flex items-center gap-3 rounded-lg border border-line p-4"><input asp-for="IsActive" class="size-4 rounded border-line" /><span class="font-semibold text-ink">Active now</span></label><div class="flex gap-3"><a asp-action="Index" ui-variant="Secondary">Cancel</a><button type="submit" ui-variant="Primary">Save changes</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
