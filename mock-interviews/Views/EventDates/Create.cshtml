@model MockInterviews.Models.ViewModels.EventDatesController.EventDateCreationViewModel
@{ ViewData["Title"] = "Add event date"; }
<section class="max-w-2xl space-y-6"><partial name="DesignSystem/_PageHeader" model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Add event date", "Create an event and its standard half-hour schedule.")' /><form asp-action="Create" method="post" class="rounded-card border border-line bg-surface p-6 shadow-card"><partial name="_FormFields" model="Model" /><div class="mt-7 flex gap-3"><a asp-action="Index" ui-variant="Secondary">Cancel</a><button type="submit" ui-variant="Primary">Create event</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
