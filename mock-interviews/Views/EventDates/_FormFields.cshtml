@model MockInterviews.Models.ViewModels.EventDatesController.EventDateCreationViewModel
<div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div>
<div><label asp-for="EventDate.Date" class="block text-sm font-semibold text-ink">Event date</label><input asp-for="EventDate.Date" class="mt-2 block min-h-11 w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm focus:border-ink focus:outline-none focus:ring-3 focus:ring-ink/10" data-dialog-initial-focus /><span asp-validation-for="EventDate.Date" class="mt-1 block text-sm text-negative"></span></div>
<div><label asp-for="EventDate.Name" class="block text-sm font-semibold text-ink">Event name</label><input asp-for="EventDate.Name" class="mt-2 block min-h-11 w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm focus:border-ink focus:outline-none focus:ring-3 focus:ring-ink/10" /><span asp-validation-for="EventDate.Name" class="mt-1 block text-sm text-negative"></span></div>
<div><label asp-for="MaxSignUps" class="block text-sm font-semibold text-ink">Maximum signups per timeslot</label><input asp-for="MaxSignUps" type="number" min="0" class="mt-2 block min-h-11 w-full rounded-md border border-line bg-surface px-3 py-2 text-ink shadow-sm focus:border-ink focus:outline-none focus:ring-3 focus:ring-ink/10" /><span asp-validation-for="MaxSignUps" class="mt-1 block text-sm text-negative"></span></div>
<fieldset class="space-y-3"><legend class="text-sm font-semibold text-ink">Eligible students</legend><label class="flex items-center gap-3"><input id="For221True" name="For221True" value="y" type="checkbox" class="size-4 rounded border-line" checked="@(Model.For221True is not null ? "checked" : null)" />MIS 221</label><label class="flex items-center gap-3"><input id="For221False" name="For221False" value="n" type="checkbox" class="size-4 rounded border-line" checked="@(Model.For221False is not null ? "checked" : null)" />MIS 321 and above</label><span asp-validation-for="EventDate.For221" class="block text-sm text-negative"></span></fieldset>
<label class="flex items-center gap-3 rounded-lg border border-line p-4"><input asp-for="EventDate.IsActive" class="size-4 rounded border-line" /><span><span class="block font-semibold text-ink">Active now</span><span class="block text-sm text-muted">Make this event available for signup.</span></span></label>
