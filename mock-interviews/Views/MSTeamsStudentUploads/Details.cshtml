@model MockInterviews.Models.Entities.RosteredStudent

@{
    ViewData["Title"] = "Roster record";
}

<section class="max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Roster record", "Review this program roster entry.")' />
    <dl class="divide-y divide-line rounded-card border border-line bg-surface shadow-card">
        <div class="p-5"><dt class="text-sm text-muted">Student</dt><dd class="mt-1 font-semibold text-ink">@Model.Name</dd></div>
        <div class="p-5"><dt class="text-sm text-muted">Email</dt><dd class="mt-1 text-ink">@Model.Email</dd></div>
        <div class="p-5"><dt class="text-sm text-muted">MIS 221</dt><dd class="mt-1 text-ink">@(Model.In221 ? "Included" : "Not included")</dd></div>
    </dl>
    <div class="flex gap-3"><a asp-action="Index" ui-variant="Secondary">Back</a><a asp-action="Edit" asp-route-id="@Model.Id" ui-variant="Primary">Edit</a></div>
</section>
