@model MockInterviews.Models.Entities.RosteredStudent

@{
    ViewData["Title"] = "Delete roster record";
}

<section class="max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Delete roster record", "This action cannot be undone.")' />
    <div class="rounded-card border border-negative/30 bg-surface p-6 shadow-card">
        <p class="leading-6 text-muted">Delete <strong class="text-ink">@Model.Name</strong> from the program roster?</p>
        <form asp-action="Delete" method="post" class="mt-7 flex gap-3">
            <input asp-for="Id" type="hidden" />
            <a asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Destructive">Delete record</button>
        </form>
    </div>
</section>
