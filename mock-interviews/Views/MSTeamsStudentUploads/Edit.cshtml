@model MockInterviews.Models.ViewModels.MSTeamsStudentUploadsController.RosterStudentEditViewModel

@{
    ViewData["Title"] = "Edit roster record";
}

<section class="max-w-xl space-y-6">
    <partial name="DesignSystem/_PageHeader"
             model='new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel("Edit roster record", "Update the student’s name, email, or MIS 221 membership.")' />

    <form asp-action="Edit" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-card">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div>
        <div>
            <label asp-for="Name" class="block text-sm font-semibold text-ink"></label>
            <input asp-for="Name" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2" />
            <span asp-validation-for="Name" class="text-sm text-negative"></span>
        </div>
        <div>
            <label asp-for="Email" class="block text-sm font-semibold text-ink"></label>
            <input asp-for="Email" class="mt-2 block min-h-11 w-full rounded-md border border-line px-3 py-2" />
            <span asp-validation-for="Email" class="text-sm text-negative"></span>
        </div>
        <label class="flex items-center gap-3 rounded-lg border border-line p-4">
            <input asp-for="In221" class="size-4" />
            <span class="font-semibold text-ink">MIS 221 student</span>
        </label>
        <div class="flex gap-3">
            <a asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Primary">Save changes</button>
        </div>
    </form>
</section>
