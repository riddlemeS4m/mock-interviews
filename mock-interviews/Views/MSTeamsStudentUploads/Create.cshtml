@model MockInterviews.Models.ViewModels.MSTeamsStudentUploadsController.MSTeamsStudentUploadViewModel

@{
    ViewData["Title"] = "Replace program roster";
    var pageHeader = new MockInterviews.Models.ViewModels.Shared.UiPageHeaderViewModel(
        "Replace program roster",
        "The uploaded CSV replaces every current program roster record after it passes validation.");
}

<section class="max-w-2xl space-y-6">
    <partial name="DesignSystem/_PageHeader" model="pageHeader" />

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-card">
        <div asp-validation-summary="ModelOnly" class="border-l-4 border-negative pl-4 text-sm text-negative"></div>
        <div>
            <label asp-for="RosterData" class="block text-sm font-semibold text-ink"></label>
            <p class="mt-1 text-sm text-muted">CSV columns: Microsoft ID, email, name. Microsoft ID is retained only for compatibility.</p>
            <input asp-for="RosterData" accept=".csv,text/csv" class="mt-3 block w-full text-sm text-ink" />
            <span asp-validation-for="RosterData" class="mt-1 block text-sm text-negative"></span>
        </div>
        <div class="flex gap-3">
            <a asp-action="Index" ui-variant="Secondary">Cancel</a>
            <button type="submit" ui-variant="Primary">Replace roster</button>
        </div>
    </form>
</section>
