@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend confirmation";
}

<div class="mx-auto max-w-md">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Resend confirmation email</h1>
    <p class="mt-2 text-muted">Enter the email address used to create your account.</p>
    <form method="post" class="mt-8 space-y-5 rounded-lg border border-line bg-surface p-6 shadow-sm">
        <div asp-validation-summary="All" ui-validation-summary></div>
        <div>
            <label asp-for="Input.Email" ui-label></label>
            <input asp-for="Input.Email" ui-control autocomplete="email" aria-required="true" />
            <span asp-validation-for="Input.Email" ui-validation></span>
        </div>
        <button type="submit" ui-variant="Primary" class="w-full">Resend confirmation</button>
    </form>
    <p class="mt-5 text-center text-sm"><a asp-page="./Login" class="font-semibold text-ink underline">Back to sign in</a></p>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
