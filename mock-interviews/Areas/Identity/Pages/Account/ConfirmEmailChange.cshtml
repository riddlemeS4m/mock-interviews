@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirm email change";
}

<div class="mx-auto max-w-xl py-12 text-center">
    <ui-icon name="mail-check" class="mx-auto size-10 text-muted" aria-hidden="true"></ui-icon>
    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-ink">Email address updated</h1>
    <div class="mt-5"><partial name="_StatusMessage" model="Model.StatusMessage" /></div>
    <a asp-page="./Manage/Email" ui-variant="Primary" class="mt-7">Return to email settings</a>
</div>
