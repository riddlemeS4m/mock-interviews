@model string

@if (!string.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
    var message = isError ? Model["Error".Length..].TrimStart(':', ' ') : Model;
    <div class="border-l-4 @(isError ? "border-negative" : "border-positive") bg-surface px-4 py-3 text-sm text-ink shadow-sm" role="@(isError ? "alert" : "status")">@message</div>
}
