@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete account";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="max-w-xl space-y-6">
    <div><h1 class="text-2xl font-semibold text-ink">Delete your account?</h1><p class="mt-1 text-sm text-muted">This permanently removes the account and cannot be undone.</p></div>
    <div class="border-l-4 border-negative bg-surface px-4 py-3 text-sm text-ink shadow-sm" role="alert"><strong>Deletion is permanent.</strong> Download any data you want to keep before continuing.</div>
    <form id="delete-user" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-sm">
        <div asp-validation-summary="ModelOnly" ui-validation-summary></div>
        @if (Model.RequirePassword)
        {
            <div><label asp-for="Input.Password" ui-label></label><input asp-for="Input.Password" ui-control autocomplete="current-password" aria-required="true" /><span asp-validation-for="Input.Password" ui-validation></span></div>
        }
        <div class="flex flex-wrap gap-3"><button type="submit" ui-variant="Destructive">Delete account permanently</button><a asp-page="./PersonalData" ui-variant="Secondary">Cancel</a></div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
