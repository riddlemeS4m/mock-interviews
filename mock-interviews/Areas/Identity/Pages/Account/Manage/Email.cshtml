@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="max-w-xl space-y-6">
    <div><h1 class="text-2xl font-semibold text-ink">Email</h1><p class="mt-1 text-sm text-muted">Change the address used for sign-in and account messages.</p></div>
    <partial name="_StatusMessage" for="StatusMessage" />
    <form id="email-form" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-sm">
        <div asp-validation-summary="All" ui-validation-summary></div>
        <div>
            <label asp-for="Email" ui-label>Current email</label>
            <input asp-for="Email" ui-control disabled />
            <p class="mt-2 flex items-center gap-2 text-sm @(Model.IsEmailConfirmed ? "text-positive" : "text-muted")">
                <span class="size-2 rounded-full @(Model.IsEmailConfirmed ? "bg-positive" : "bg-warning")"></span>
                @(Model.IsEmailConfirmed ? "Confirmed" : "Confirmation required")
            </p>
            @if (!Model.IsEmailConfirmed)
            {
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="mt-2 text-sm font-semibold text-ink underline">Send verification email</button>
            }
        </div>
        <div><label asp-for="Input.NewEmail" ui-label></label><input asp-for="Input.NewEmail" ui-control autocomplete="email" aria-required="true" /><span asp-validation-for="Input.NewEmail" ui-validation></span></div>
        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" ui-variant="Primary">Change email</button>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
