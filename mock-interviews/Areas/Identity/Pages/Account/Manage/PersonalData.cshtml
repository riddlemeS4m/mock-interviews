@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="max-w-2xl space-y-8">
    <div><h1 class="text-2xl font-semibold text-ink">Personal data</h1><p class="mt-1 text-sm text-muted">Download a copy of your account data or request account deletion.</p></div>
    <div class="rounded-card border border-line bg-surface p-6 shadow-sm">
        <h2 class="font-semibold text-ink">Download your data</h2><p class="mt-1 text-sm text-muted">Get a machine-readable copy of the personal information stored with your account.</p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post" class="mt-5"><button type="submit" ui-variant="Secondary">Download data</button></form>
    </div>
    <div class="border-t border-line pt-7">
        <h2 class="font-semibold text-ink">Close your account</h2><p class="mt-1 max-w-xl text-sm text-muted">Account deletion is permanent. Accounts connected to interview or signup records cannot be deleted until those records are resolved.</p>
        <a id="delete" asp-page="DeletePersonalData" ui-variant="Destructive" class="mt-5">Delete account</a>
    </div>
</div>
