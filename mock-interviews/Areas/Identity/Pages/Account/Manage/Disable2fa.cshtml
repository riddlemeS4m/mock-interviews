@page
@model Disable2faModel
@{
    ViewData["Title"] = "Disable two-factor authentication";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="max-w-xl space-y-6">
    <div><h1 class="text-2xl font-semibold text-ink">Disable two-factor authentication?</h1><p class="mt-1 text-sm text-muted">Your password will become the only protection on this account.</p></div>
    <div class="border-l-4 border-warning bg-surface px-4 py-3 text-sm text-ink shadow-sm"><strong>Your authenticator key will remain unchanged.</strong> Reset the authenticator separately if you also want to replace that key.</div>
    <form method="post" class="flex gap-3"><button type="submit" ui-variant="Destructive">Disable 2FA</button><a asp-page="./TwoFactorAuthentication" ui-variant="Secondary">Cancel</a></form>
</div>
