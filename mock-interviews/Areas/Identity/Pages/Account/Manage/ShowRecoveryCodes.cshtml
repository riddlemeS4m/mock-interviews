@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="max-w-xl space-y-6">
    <div><h1 class="text-2xl font-semibold text-ink">Save your recovery codes</h1><p class="mt-1 text-sm text-muted">Each code can be used once if you lose access to your authenticator.</p></div>
    <div class="border-l-4 border-warning bg-surface px-4 py-3 text-sm text-ink shadow-sm"><strong>This is your only chance to copy these codes.</strong> Store them in a password manager or another secure location.</div>
    <div class="grid grid-cols-2 gap-3 rounded-card border border-line bg-surface p-6 shadow-sm">
        @foreach (var code in Model.RecoveryCodes)
        {
            <code class="rounded-md bg-soft px-3 py-2 text-center font-mono text-sm text-ink">@code</code>
        }
    </div>
    <a asp-page="./TwoFactorAuthentication" ui-variant="Primary">Done</a>
</div>
