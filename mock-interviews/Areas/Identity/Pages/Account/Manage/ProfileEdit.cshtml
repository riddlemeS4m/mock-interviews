@page
@using MockInterviews.Data;
@using MockInterviews.Data.Constants;
@model UserProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
    ViewData["ActivePage"] = ManageNavPages.ProfileEdit;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-10">
        <form id="profile-form" method="post">
            <div class="row">
                <div class="col-md-8">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="Input.FirstName"></label>
                        <input asp-for="Input.FirstName" class="form-control" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="Input.LastName"></label>
                        <input asp-for="Input.LastName" class="form-control" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="Input.PhoneNumber"></label>
                        <input asp-for="Input.PhoneNumber" class="form-control" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                    <br />
                    @if (User.IsInRole(RolesConstants.InterviewerRole))
                    {
                        <div class="form-group">
                            <label asp-for="Input.Company" class="control-label"></label>
                            <input asp-for="Input.Company" class="form-control" />
                            <span asp-validation-for="Input.Company" class="text-danger"></span>
                        </div>
                        <br />
                    }
                    @if (User.IsInRole(RolesConstants.StudentRole))
                    {
                        <div class="form-group">
                            <label asp-for="Input.Class" class="control-label"></label>
                            <select asp-for="Input.Class" class="form-control" asp-items='@ClassConstants.GetClassOptions()'>
                                <option value="">-- Select One --</option>
                            </select>
                            <span asp-validation-for="Input.Class" class="text-danger"></span>
                        </div>
                        <br />
                    } 
                    
                    <button id="update-profile-button" type="submit" class="btn btn-primary">Save</button>
                </div>
                <div class="col-md-4">
                    <img src="~/images/SabanHeadshot.jpg"
                         alt="Default profile picture"
                         style="width:350px;height:350px; object-fit:cover" />
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
