@page
@using MockInterviews.Data.Constants
@model UserProfileViewModel
@{
    ViewData["Title"] = "Edit profile";
    ViewData["ActivePage"] = ManageNavPages.ProfileEdit;
}

<div class="max-w-xl space-y-6">
    <div><h1 class="text-2xl font-semibold text-ink">Edit profile</h1><p class="mt-1 text-sm text-muted">Keep your name and participant details current.</p></div>
    <partial name="_StatusMessage" for="StatusMessage" />
    <form id="profile-form" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-sm">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" ui-validation-summary></div>
        <div><label asp-for="Input.FirstName" ui-label></label><input asp-for="Input.FirstName" ui-control autocomplete="given-name" /><span asp-validation-for="Input.FirstName" ui-validation></span></div>
        <div><label asp-for="Input.LastName" ui-label></label><input asp-for="Input.LastName" ui-control autocomplete="family-name" /><span asp-validation-for="Input.LastName" ui-validation></span></div>
        <div><label asp-for="Input.PhoneNumber" ui-label></label><input asp-for="Input.PhoneNumber" ui-control autocomplete="tel" /><p class="mt-1 text-xs text-muted">Optional</p><span asp-validation-for="Input.PhoneNumber" ui-validation></span></div>
        @if (User.IsInRole(RolesConstants.InterviewerRole))
        {
            <div><label asp-for="Input.Company" ui-label></label><input asp-for="Input.Company" ui-control autocomplete="organization" /><span asp-validation-for="Input.Company" ui-validation></span></div>
        }
        @if (User.IsInRole(RolesConstants.StudentRole))
        {
            <div><label asp-for="Input.Class" ui-label></label><select asp-for="Input.Class" ui-control asp-items="@ClassConstants.GetClassOptions()"><option value="">Select a class</option></select><span asp-validation-for="Input.Class" ui-validation></span></div>
        }
        <div class="flex gap-3 pt-1"><button id="update-profile-button" type="submit" ui-variant="Primary">Save changes</button><a asp-page="./Index" ui-variant="Secondary">Cancel</a></div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
