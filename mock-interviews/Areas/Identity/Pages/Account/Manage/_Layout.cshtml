@{
    Layout = "/Views/Shared/_TailwindLayout.cshtml";
}

<section class="space-y-8">
    <partial name="DesignSystem/_PageHeader"
             model='new UiPageHeaderViewModel("Account settings", "Manage your profile, sign-in methods, security, and personal data.")' />

    <div class="grid gap-8 md:grid-cols-[14rem_minmax(0,1fr)]">
        <aside>
            <partial name="_ManageNav" />
        </aside>
        <div class="min-w-0">
            @RenderBody()
        </div>
    </div>
</section>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
