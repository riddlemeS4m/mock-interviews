@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="max-w-2xl space-y-6">
    <div><h1 class="text-2xl font-semibold text-ink">Configure authenticator</h1><p class="mt-1 text-sm text-muted">Connect the authenticator app of your choice in three steps.</p></div>
    <partial name="_StatusMessage" for="StatusMessage" />
    <ol class="space-y-5">
        <li class="rounded-card border border-line bg-surface p-5 shadow-sm"><div class="flex gap-4"><span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-ink text-sm font-semibold text-white">1</span><div><h2 class="font-semibold text-ink">Install an authenticator app</h2><p class="mt-1 text-sm text-muted">Microsoft Authenticator, Google Authenticator, 1Password, and other TOTP apps are supported.</p></div></div></li>
        <li class="rounded-card border border-line bg-surface p-5 shadow-sm"><div class="flex gap-4"><span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-ink text-sm font-semibold text-white">2</span><div class="min-w-0"><h2 class="font-semibold text-ink">Add this account</h2><p class="mt-1 text-sm text-muted">Enter this setup key in your app. Spaces and capitalization do not matter.</p><code class="mt-3 block break-all rounded-md bg-soft px-3 py-2 font-mono text-sm text-ink">@Model.SharedKey</code><div id="qrCode" class="mt-4"></div><div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div></div></div></li>
        <li class="rounded-card border border-line bg-surface p-5 shadow-sm"><div class="flex gap-4"><span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-ink text-sm font-semibold text-white">3</span><div class="w-full"><h2 class="font-semibold text-ink">Verify the code</h2><form id="send-code" method="post" class="mt-4 space-y-4"><div><label asp-for="Input.Code" ui-label>Verification code</label><input asp-for="Input.Code" ui-control autocomplete="one-time-code" inputmode="numeric" /><span asp-validation-for="Input.Code" ui-validation></span></div><div asp-validation-summary="ModelOnly" ui-validation-summary></div><button type="submit" ui-variant="Primary">Verify</button></form></div></div></li>
    </ol>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
