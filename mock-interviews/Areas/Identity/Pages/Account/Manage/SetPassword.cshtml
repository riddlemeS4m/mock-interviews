@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Set password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="max-w-xl space-y-6">
    <div><h1 class="text-2xl font-semibold text-ink">Set a password</h1><p class="mt-1 text-sm text-muted">Add a password so you can sign in without an external provider.</p></div>
    <partial name="_StatusMessage" for="StatusMessage" />
    <form id="set-password-form" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-sm">
        <div asp-validation-summary="ModelOnly" ui-validation-summary></div>
        <div><label asp-for="Input.NewPassword" ui-label></label><input asp-for="Input.NewPassword" ui-control autocomplete="new-password" /><span asp-validation-for="Input.NewPassword" ui-validation></span></div>
        <div><label asp-for="Input.ConfirmPassword" ui-label></label><input asp-for="Input.ConfirmPassword" ui-control autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" ui-validation></span></div>
        <button type="submit" ui-variant="Primary">Set password</button>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
