@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="max-w-xl space-y-6">
    <div><h1 class="text-2xl font-semibold text-ink">Change password</h1><p class="mt-1 text-sm text-muted">Use a unique password that you do not use elsewhere.</p></div>
    <partial name="_StatusMessage" for="StatusMessage" />
    <form id="change-password-form" method="post" class="space-y-5 rounded-card border border-line bg-surface p-6 shadow-sm">
        <div asp-validation-summary="ModelOnly" ui-validation-summary></div>
        <div><label asp-for="Input.OldPassword" ui-label></label><input asp-for="Input.OldPassword" ui-control autocomplete="current-password" aria-required="true" /><span asp-validation-for="Input.OldPassword" ui-validation></span></div>
        <div><label asp-for="Input.NewPassword" ui-label></label><input asp-for="Input.NewPassword" ui-control autocomplete="new-password" aria-required="true" /><span asp-validation-for="Input.NewPassword" ui-validation></span></div>
        <div><label asp-for="Input.ConfirmPassword" ui-label></label><input asp-for="Input.ConfirmPassword" ui-control autocomplete="new-password" aria-required="true" /><span asp-validation-for="Input.ConfirmPassword" ui-validation></span></div>
        <button type="submit" ui-variant="Primary">Update password</button>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
