@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Reset authenticator";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="max-w-xl space-y-6">
    <div><h1 class="text-2xl font-semibold text-ink">Reset authenticator?</h1><p class="mt-1 text-sm text-muted">Your current authenticator codes will immediately stop working.</p></div>
    <div class="border-l-4 border-warning bg-surface px-4 py-3 text-sm text-ink shadow-sm"><strong>Two-factor authentication will be disabled until setup is complete.</strong> Finish configuring the new key before signing out.</div>
    <form id="reset-authenticator-form" method="post" class="flex gap-3"><button id="reset-authenticator-button" type="submit" ui-variant="Destructive">Reset authenticator</button><a asp-page="./TwoFactorAuthentication" ui-variant="Secondary">Cancel</a></form>
</div>
