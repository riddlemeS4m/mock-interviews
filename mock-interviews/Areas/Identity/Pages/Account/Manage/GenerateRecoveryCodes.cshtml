@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="max-w-xl space-y-6">
    <div><h1 class="text-2xl font-semibold text-ink">Generate new recovery codes?</h1><p class="mt-1 text-sm text-muted">Any recovery codes you previously saved will stop working.</p></div>
    <div class="border-l-4 border-warning bg-surface px-4 py-3 text-sm text-ink shadow-sm"><strong>Store the new codes somewhere safe.</strong> Without your device or a recovery code, you may lose access to this account.</div>
    <form method="post" class="flex gap-3"><button type="submit" ui-variant="Primary">Generate codes</button><a asp-page="./TwoFactorAuthentication" ui-variant="Secondary">Cancel</a></form>
</div>
