@inject SignInManager<MockInterviews.Models.Identity.ApplicationUser> SignInManager

@{
    const string linkClasses = "block rounded-md px-3 py-2 text-sm font-semibold transition-colors";
    string Classes(string? activeClass) => $"{linkClasses} {(activeClass == "active" ? "bg-ink text-white" : "text-ink hover:bg-soft")}";
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<nav aria-label="Account settings" class="space-y-1 rounded-card border border-line bg-surface p-2 shadow-sm">
    <a class="@Classes(ManageNavPages.IndexNavClass(ViewContext))" id="profile" asp-page="./Index">Profile</a>
    <a class="@Classes(ManageNavPages.ProfileEditClass(ViewContext))" id="profile-edit" asp-page="./ProfileEdit">Edit profile</a>
    <a class="@Classes(ManageNavPages.EmailNavClass(ViewContext))" id="email" asp-page="./Email">Email</a>
    <a class="@Classes(ManageNavPages.ChangePasswordNavClass(ViewContext))" id="change-password" asp-page="./ChangePassword">Password</a>
    @if (hasExternalLogins)
    {
        <a class="@Classes(ManageNavPages.ExternalLoginsNavClass(ViewContext))" id="external-logins" asp-page="./ExternalLogins">External sign-ins</a>
    }
    <a class="@Classes(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext))" id="two-factor" asp-page="./TwoFactorAuthentication">Two-factor authentication</a>
    <a class="@Classes(ManageNavPages.PersonalDataNavClass(ViewContext))" id="personal-data" asp-page="./PersonalData">Personal data</a>
</nav>
