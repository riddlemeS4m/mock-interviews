@page
@model LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<div class="mx-auto max-w-xl py-12 text-center">
    <ui-icon name="log-out" class="mx-auto size-10 text-muted" aria-hidden="true"></ui-icon>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <h1 class="mt-5 text-3xl font-semibold tracking-tight text-ink">Ready to sign out?</h1>
        <p class="mt-3 text-muted">You will need to sign in again to manage your interviews.</p>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post" class="mt-7">
            <button type="submit" ui-variant="Primary">Sign out</button>
        </form>
    }
    else
    {
        <h1 class="mt-5 text-3xl font-semibold tracking-tight text-ink">You are signed out</h1>
        <p class="mt-3 text-muted">Your session has ended safely.</p>
        <a asp-page="./Login" ui-variant="Primary" class="mt-7">Sign in again</a>
    }
</div>
