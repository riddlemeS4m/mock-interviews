@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Choose new password";
}

<section class="mx-auto max-w-lg">
    <div class="rounded-card border border-line bg-surface p-6 shadow-card sm:p-8">
        <h1 class="text-3xl font-bold tracking-tight text-ink">Choose a new password</h1>
        <p class="mt-2 leading-6 text-muted">Use a unique password you do not use for another account.</p>

        <form method="post" class="mt-7 space-y-5">
            <div asp-validation-summary="ModelOnly" ui-validation-summary></div>
            <input asp-for="Input.Code" type="hidden" />
            <div>
                <label asp-for="Input.Email" ui-label></label>
                <input asp-for="Input.Email" ui-control autocomplete="email" />
                <span asp-validation-for="Input.Email" ui-validation></span>
            </div>
            <div>
                <label asp-for="Input.Password" ui-label></label>
                <input asp-for="Input.Password" ui-control autocomplete="new-password" />
                <span asp-validation-for="Input.Password" ui-validation></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword" ui-label></label>
                <input asp-for="Input.ConfirmPassword" ui-control autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" ui-validation></span>
            </div>
            <button type="submit" ui-variant="Primary" class="w-full">Reset password</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
