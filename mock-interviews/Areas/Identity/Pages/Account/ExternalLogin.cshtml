@page
@model ExternalLoginModel

@{
    ViewData["Title"] = "Complete account";
}

<section class="mx-auto max-w-lg">
    <div class="rounded-card border border-line bg-surface p-6 shadow-card sm:p-8">
        <h1 class="text-3xl font-bold tracking-tight text-ink">Complete your account</h1>
        <p class="mt-2 leading-6 text-muted">You authenticated with @Model.ProviderDisplayName. Confirm the information used for your Mock Interviews account.</p>

        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-7 space-y-5">
            <div asp-validation-summary="ModelOnly" ui-validation-summary></div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Input.FirstName" ui-label></label>
                    <input asp-for="Input.FirstName" ui-control autocomplete="given-name" />
                    <span asp-validation-for="Input.FirstName" ui-validation></span>
                </div>
                <div>
                    <label asp-for="Input.LastName" ui-label></label>
                    <input asp-for="Input.LastName" ui-control autocomplete="family-name" />
                    <span asp-validation-for="Input.LastName" ui-validation></span>
                </div>
            </div>

            <div>
                <label asp-for="Input.Email" ui-label></label>
                <input asp-for="Input.Email" ui-control autocomplete="email" readonly />
                <span asp-validation-for="Input.Email" ui-validation></span>
            </div>

            <button type="submit" ui-variant="Primary" class="w-full">Create account</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
