@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}

<div class="mx-auto max-w-xl py-12 text-center">
    <ui-icon name="mail" class="mx-auto size-10 text-muted" aria-hidden="true"></ui-icon>
    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-ink">Confirm your email</h1>
    <p class="mt-3 text-muted">We sent a confirmation link to <strong class="font-semibold text-ink">@Model.Email</strong>. Open it before signing in.</p>
    <div class="mt-7 flex justify-center gap-3">
        <a asp-page="./Login" ui-variant="Primary">Go to sign in</a>
        <a asp-page="./ResendEmailConfirmation" ui-variant="Secondary">Resend email</a>
    </div>
</div>
