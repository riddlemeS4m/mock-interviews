@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
}

<div class="mx-auto max-w-xl py-12 text-center">
    <ui-icon name="circle-check" class="mx-auto size-10 text-positive" aria-hidden="true"></ui-icon>
    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-ink">Password updated</h1>
    <p class="mt-3 text-muted">Your new password is ready to use.</p>
    <a asp-page="./Login" ui-variant="Primary" class="mt-7">Sign in</a>
</div>
