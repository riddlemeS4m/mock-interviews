@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
}

<div class="mx-auto max-w-md">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Verify your sign-in</h1>
    <p class="mt-2 text-muted">Enter the code from your authenticator app.</p>
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="mt-8 space-y-5 rounded-lg border border-line bg-surface p-6 shadow-sm">
        <input asp-for="RememberMe" type="hidden" />
        <div asp-validation-summary="ModelOnly" ui-validation-summary></div>
        <div>
            <label asp-for="Input.TwoFactorCode" ui-label></label>
            <input asp-for="Input.TwoFactorCode" ui-control autocomplete="one-time-code" inputmode="numeric" />
            <span asp-validation-for="Input.TwoFactorCode" ui-validation></span>
        </div>
        <label asp-for="Input.RememberMachine" class="flex items-start gap-3 text-sm text-ink">
            <input asp-for="Input.RememberMachine" class="mt-0.5 size-4 accent-ink" />
            <span>@Html.DisplayNameFor(m => m.Input.RememberMachine)</span>
        </label>
        <button type="submit" ui-variant="Primary" class="w-full">Verify and sign in</button>
    </form>
    <p class="mt-5 text-center text-sm text-muted">
        Cannot use your authenticator?
        <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="font-semibold text-ink underline">Use a recovery code</a>
    </p>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
