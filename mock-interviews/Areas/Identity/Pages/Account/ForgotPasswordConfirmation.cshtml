@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your email";
}

<div class="mx-auto max-w-xl py-12 text-center">
    <ui-icon name="mail" class="mx-auto size-10 text-muted" aria-hidden="true"></ui-icon>
    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-ink">Check your email</h1>
    <p class="mt-3 text-muted">If an account exists for that address, we sent instructions for resetting its password.</p>
    <a asp-page="./Login" ui-variant="Secondary" class="mt-7">Back to sign in</a>
</div>
