@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="mx-auto max-w-xl py-12 text-center">
    <ui-icon name="shield-alert" class="mx-auto size-10 text-negative" aria-hidden="true"></ui-icon>
    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-ink">You cannot access this page</h1>
    <p class="mt-3 text-muted">Your account is signed in, but it does not have permission to use this resource.</p>
    <div class="mt-7 flex justify-center gap-3">
        <a asp-area="" asp-controller="Home" asp-action="Landing" ui-variant="Primary">Go to dashboard</a>
        <a asp-area="Identity" asp-page="/Account/Manage/ProfileEdit" ui-variant="Secondary">Review profile</a>
    </div>
</div>
