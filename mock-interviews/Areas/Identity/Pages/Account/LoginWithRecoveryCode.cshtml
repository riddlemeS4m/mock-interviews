@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code";
}

<div class="mx-auto max-w-md">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Use a recovery code</h1>
    <p class="mt-2 text-muted">This sign-in will not be remembered. Use an authenticator code on your next sign-in or update two-factor authentication in account settings.</p>
    <form method="post" class="mt-8 space-y-5 rounded-lg border border-line bg-surface p-6 shadow-sm">
        <div asp-validation-summary="ModelOnly" ui-validation-summary></div>
        <div>
            <label asp-for="Input.RecoveryCode" ui-label></label>
            <input asp-for="Input.RecoveryCode" ui-control autocomplete="off" />
            <span asp-validation-for="Input.RecoveryCode" ui-validation></span>
        </div>
        <button type="submit" ui-variant="Primary" class="w-full">Sign in</button>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
