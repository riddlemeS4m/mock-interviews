@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Reset password";
}

<section class="mx-auto max-w-lg">
    <div class="rounded-card border border-line bg-surface p-6 shadow-card sm:p-8">
        <h1 class="text-3xl font-bold tracking-tight text-ink">Reset your password</h1>
        <p class="mt-2 leading-6 text-muted">Enter your confirmed email address and we’ll send a secure reset link.</p>

        <form method="post" class="mt-7 space-y-5">
            <div asp-validation-summary="ModelOnly" ui-validation-summary></div>
            <div>
                <label asp-for="Input.Email" ui-label></label>
                <input asp-for="Input.Email" ui-control autocomplete="email" autofocus />
                <span asp-validation-for="Input.Email" ui-validation></span>
            </div>
            <button type="submit" ui-variant="Primary" class="w-full">Send reset link</button>
        </form>

        <p class="mt-7 text-center text-sm">
            <a asp-page="./Login" class="font-semibold text-ink hover:underline">Back to sign in</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
