@page
@model RegisterModel

@{
    ViewData["Title"] = "Create account";
}

<section class="mx-auto max-w-2xl">
    <div class="rounded-card border border-line bg-surface p-6 shadow-card sm:p-8">
        <h1 class="text-3xl font-bold tracking-tight text-ink">Create your account</h1>
        <p class="mt-2 leading-6 text-muted">Rostered students receive student access automatically. Other accounts remain pending until an administrator grants access or an interviewer signup is completed.</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-7 space-y-5">
            <div asp-validation-summary="ModelOnly" ui-validation-summary></div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Input.FirstName" ui-label></label>
                    <input asp-for="Input.FirstName" ui-control autocomplete="given-name" />
                    <span asp-validation-for="Input.FirstName" ui-validation></span>
                </div>
                <div>
                    <label asp-for="Input.LastName" ui-label></label>
                    <input asp-for="Input.LastName" ui-control autocomplete="family-name" />
                    <span asp-validation-for="Input.LastName" ui-validation></span>
                </div>
            </div>

            <div>
                <label asp-for="Input.Email" ui-label></label>
                <input asp-for="Input.Email" ui-control autocomplete="email" />
                <span asp-validation-for="Input.Email" ui-validation></span>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Input.Password" ui-label></label>
                    <input asp-for="Input.Password" ui-control autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" ui-validation></span>
                </div>
                <div>
                    <label asp-for="Input.ConfirmPassword" ui-label></label>
                    <input asp-for="Input.ConfirmPassword" ui-control autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" ui-validation></span>
                </div>
            </div>

            <button id="registerSubmit" type="submit" ui-variant="Primary" class="w-full">Create account</button>
        </form>

        <p class="mt-7 text-center text-sm text-muted">
            Already registered?
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="font-semibold text-ink hover:underline">Sign in</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
