@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="mx-auto max-w-xl py-12 text-center">
    <ui-icon name="triangle-alert" class="mx-auto size-10 text-negative"></ui-icon>
    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-ink">Something went wrong</h1>
    <p class="mt-3 text-muted">We could not complete that account request. Try again, or return to your dashboard.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-xs text-muted">Request ID: <code class="font-mono text-ink">@Model.RequestId</code></p>
    }
    <a asp-area="" asp-controller="Home" asp-action="Index" ui-variant="Primary" class="mt-7">Return home</a>
</div>
