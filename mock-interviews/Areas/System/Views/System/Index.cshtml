@{
    ViewData["Title"] = "System Admin";
}

<section class="space-y-8">
    <partial name="DesignSystem/_PageHeader" model='new UiPageHeaderViewModel("System Administration", "A dedicated workspace for the tools that keep Mock Interviews running smoothly.")' />

    <div class="grid gap-6 md:grid-cols-2">
        <article class="rounded-card border border-line bg-surface p-6 shadow-card">
            <ui-icon name="users" class="size-6 text-muted" />
            <h2 class="mt-4 text-xl font-semibold text-ink">User and role management</h2>
            <p class="mt-3 leading-6 text-muted">Manage system access and responsibilities from one focused location.</p>
        </article>

        <article class="rounded-card border border-line bg-surface p-6 shadow-card">
            <ui-icon name="layout-dashboard" class="size-6 text-muted" />
            <h2 class="mt-4 text-xl font-semibold text-ink">UI design system</h2>
            <p class="mt-3 leading-6 text-muted">Use the living reference for application shells, typography, controls, feedback, data, and shared states.</p>
            <a asp-area="System" asp-controller="System" asp-action="Design" ui-variant="Primary" class="mt-5">
                Open design system
                <ui-icon name="chevron-right" class="size-4" />
            </a>
        </article>
    </div>
</section>
