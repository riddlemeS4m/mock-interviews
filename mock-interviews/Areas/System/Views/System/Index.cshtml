@{
    ViewData["Title"] = "System Admin";
}

<section class="space-y-8">
    <div class="max-w-3xl space-y-3">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">System</p>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">System Administration</h1>
        <p class="text-lg leading-8 text-slate-600">
            A dedicated workspace for the tools that keep Mock Interviews running smoothly.
        </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-semibold text-brand-700">Planned</p>
            <h2 class="mt-2 text-xl font-semibold text-slate-900">User and role management</h2>
            <p class="mt-3 leading-6 text-slate-600">Manage system access and responsibilities from one focused location.</p>
        </article>

        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-semibold text-brand-700">Planned</p>
            <h2 class="mt-2 text-xl font-semibold text-slate-900">System configuration</h2>
            <p class="mt-3 leading-6 text-slate-600">Review and maintain application-wide settings as these tools are introduced.</p>
        </article>
    </div>
</section>
